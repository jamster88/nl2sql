# The GUIs' build inputs and outputs. package-lock.json is committed; what
# it installs is not.
gui/node_modules/
gui/dist/
gui/coverage/
review/gui/node_modules/
review/gui/dist/
review/gui/coverage/
console/node_modules/
console/dist/
