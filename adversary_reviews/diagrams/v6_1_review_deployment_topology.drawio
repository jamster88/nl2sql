<mxCell id="n13" value="TLS material" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="70" width="290" height="20" as="geometry"/></mxCell>
<mxCell id="n14" value="Published on every interface (0.0.0.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1200" height="760" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;api :8443 (HTTPS)&lt;/b&gt;&lt;br&gt;agent image, root&lt;br&gt;session (nl2sql_users)&lt;br&gt;presents the shared key&lt;br&gt;CORS * by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="180" height="104" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;gui :8080 (nginx, HTTPS)&lt;/b&gt;&lt;br&gt;holds no token with sign-in on&lt;br&gt;proxies /auth/ and /v1/&lt;br&gt;root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="255" y="160" width="180" height="104" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;review :8444 (HTTPS)&lt;/b&gt;&lt;br&gt;session (reviewers / curators)&lt;br&gt;presents the shared key&lt;br&gt;writes ./context_questions as root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="180" height="104" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;reviewgui :8081 (nginx)&lt;/b&gt;&lt;br&gt;curategui :8083 (nginx)&lt;br&gt;no token with sign-in on&lt;br&gt;root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="645" y="160" width="180" height="104" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;auth :8446 (HTTPS)&lt;/b&gt;&lt;br&gt;sign-in; /directory/v1 (admins)&lt;br&gt;signing key in its own volume&lt;br&gt;presents the shared key; root&lt;br&gt;rolesync: CREATEROLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="160" width="180" height="104" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;apitest (smoke test)&lt;/b&gt;&lt;br&gt;mounts apitls read-only&lt;br&gt;curl + jq, alpine:3.21" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1035" y="160" width="190" height="104" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;volume apitls&lt;/b&gt;&lt;br&gt;server.key (0600, root) + server.crt, written by api&lt;br&gt;presented as their own identity by api, review, console, auth&lt;br&gt;mounted into 11 containers; 7 need only the certificate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;volume authkeys&lt;/b&gt;&lt;br&gt;session.pub, written by auth&lt;br&gt;read-only in api, console, review&lt;br&gt;re-read when it changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="410" y="320" width="220" height="112" as="geometry"/></mxCell>
<mxCell id="n23" value="&lt;b&gt;volume authdata&lt;/b&gt;&lt;br&gt;session.key (0600)&lt;br&gt;mounted by auth alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="650" y="320" width="190" height="112" as="geometry"/></mxCell>
<mxCell id="n24" value="&lt;b&gt;volume ldaptls&lt;/b&gt;&lt;br&gt;ldap.crt + ldap.key, written by ldap&lt;br&gt;read-only in postgres and auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="200" height="112" as="geometry"/></mxCell>
<mxCell id="n25" value="&lt;b&gt;bind mount&lt;/b&gt;&lt;br&gt;./context_questions (rw)&lt;br&gt;root-owned writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1080" y="320" width="145" height="112" as="geometry"/></mxCell>
<mxCell id="n26" value="&lt;b&gt;retail db :5432 -- no TLS&lt;/b&gt;&lt;br&gt;nl2sql / nl2sql&lt;br&gt;superuser postgres / nl2sql&lt;br&gt;rolesync: generated&lt;br&gt;pg_hba: sign-in block, then&lt;br&gt;host all all all scram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="158" height="130" as="geometry"/></mxCell>
