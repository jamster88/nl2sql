<mxCell id="n38" value="&lt;b&gt;directorygui :8084 (nginx)&lt;/b&gt;&lt;br&gt;its API is /directory/v1 on auth :8446&lt;br&gt;-- every interface (M-10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1290" y="320" width="230" height="64" as="geometry"/></mxCell>
<mxCell id="n39" value="&lt;b&gt;mlflowproxy :5001 (HTTPS)&lt;/b&gt;&lt;br&gt;auth_request -&amp;gt; /auth/verify&lt;br&gt;Basic or session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1290" y="400" width="230" height="64" as="geometry"/></mxCell>
<mxCell id="n40" value="Not published" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1270" y="500" width="270" height="360" as="geometry"/></mxCell>
<mxCell id="n41" value="&lt;b&gt;ldap :389 / :636 (OpenLDAP)&lt;/b&gt;&lt;br&gt;runs as ldap (become); own key&lt;br&gt;StartTLS required for a password&lt;br&gt;Argon2; lockout after 5&lt;br&gt;replica: remoteauth to the primary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="540" width="230" height="110" as="geometry"/></mxCell>
