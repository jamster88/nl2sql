<mxCell id="n5" value="every interface; a session is required" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="290" height="20" as="geometry"/></mxCell>
<mxCell id="n6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="340" y="74" width="16" height="14" as="geometry"/></mxCell>
