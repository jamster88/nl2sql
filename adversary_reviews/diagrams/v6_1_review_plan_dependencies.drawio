<mxCell id="n2" value="The v6.1 plan: phases, status of the first plan's items, and the dependency it missed" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="30" as="geometry"/></mxCell>
<mxCell id="n3" value="Green: done in 6.0 (V6-01, V6-10, V6-21, V6-30; V6-09 superseded). Orange: partial. Black: open. Blue: new (V6-52 to V6-71). The red edge is V6-36 -&amp;gt; V6-31, which moves separate TLS identities to Phase 1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1480" height="24" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;Phase 0 -- decisions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;V6-01 identity&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-02 sensitive policy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-03 topology&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-04 review writes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-05 benchmark wording&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-70 direct DB access&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-71 revocation model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="170" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;Phase 1 -- safe defaults, transport, secrets&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-06 stores on loopback&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-07 retail v1_2, no baked superuser&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-52 TLS for the retail database&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-53 hostssl + verify-full&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-08 generated secrets&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-54 secure default in the code&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-36 own TLS identities (moved here)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;V6-10 constant-time&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-11 log scrub&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-12 CORS none&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-13 queue bound   V6-14 EXPLAIN timeout&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-55..58 argv, X-Forwarded-Proto,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;  replica TLS, directory API&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-59 red test   V6-60 default-deny test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=9;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="260" height="300" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;Phase 2 -- pipeline&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-15 per-attempt reset&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-16 node_errors&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-17 sensitive policy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-18 trace fields over REST&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-19 extra=forbid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;Phase 3 -- foundations&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-20 shared package&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-66 installed as a package&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;V6-21 Principal&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-22 engine accessor&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-23 error taxonomy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-24 pins + hashes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-25 web package + sign-in gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Phase 4 -- service refactors&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-26 routers, default-deny&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-27 review writes via library&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-28 non-root review&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-29 sequences&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;V6-30 identity applied&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-31 non-root images (1 of 15)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;  &amp;lt;- waits for V6-36&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-32 operator-only detail&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-33 cache reload (admins exist)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-61 session revocation&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-62 named service tokens&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-63 trusted proxies&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-64 application_name&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=9;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="240" height="320" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;Phase 5 -- hardening, topology&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-34 compose hardening&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-35 digests, one Alpine&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-65 no start-up dependency&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;  on the API's certificate&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-37 one proxy image&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-38 compose secrets&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-39 role limits&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-40 consolidation&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-41 ops in Python&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-42 provenance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=9;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;Phase 6 -- documentation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-43 arch6 (+ sign-in)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-68 sign-in design&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-44 verified blueprint&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-45 threat model, tiers&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b26a00&quot;&gt;V6-46 overstated controls&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-69 cost of direct access&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-47 one home per fact&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-48 comment policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=9;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1140" y="350" width="200" height="170" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Phase 7 -- tests&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-49 security tier&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;V6-67 acceptance tier&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1f5fbf&quot;&gt;  -- land first&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-50 drift tests&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;V6-51 coverage exclusions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1370" y="120" width="170" height="170" as="geometry"/></mxCell>
