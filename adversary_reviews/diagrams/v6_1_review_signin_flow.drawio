<mxCell id="n2" value="How a sign-in travels at 6.0.1, and where the password is in clear text" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="30" as="geometry"/></mxCell>
<mxCell id="n3" value="auth/nl2sql_auth/login.py, auth/nl2sql_identity/guard.py, docker/ldap_hba.sh, gui/nginx.conf.template. Red: a clear-text password. Green: TLS, verified. Purple: a signed session. Grey: a static token." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1480" height="24" as="geometry"/></mxCell>
<mxCell id="n4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="16" height="14" as="geometry"/></mxCell>
<mxCell id="n5" value="clear-text password" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="260" height="20" as="geometry"/></mxCell>
<mxCell id="n6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="330" y="74" width="16" height="14" as="geometry"/></mxCell>
<mxCell id="n7" value="TLS, certificate verified" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="260" height="20" as="geometry"/></mxCell>
<mxCell id="n8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="620" y="74" width="16" height="14" as="geometry"/></mxCell>
<mxCell id="n9" value="signed session (Ed25519 JWT)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="260" height="20" as="geometry"/></mxCell>
<mxCell id="n10" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="910" y="74" width="16" height="14" as="geometry"/></mxCell>
<mxCell id="n11" value="static service token" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="260" height="20" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;any page :8080 / :8081 / :8083&lt;br&gt;(HTTPS, self-signed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Desktop client&lt;/b&gt;&lt;br&gt;--auth-url https://host:8446&lt;br&gt;token kept in memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;psql / a BI tool&lt;/b&gt;&lt;br&gt;on another machine&lt;br&gt;(documented: rolesync.py:14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;MLflow client&lt;/b&gt;&lt;br&gt;MLFLOW_TRACKING_USERNAME&lt;br&gt;/ _PASSWORD (Basic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;nginx (the page's)&lt;/b&gt;&lt;br&gt;proxies /auth/ and /v1/&lt;br&gt;X-Forwarded-Host, -Proto=$scheme&lt;br&gt;holds no token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;mlflowproxy :5001&lt;/b&gt;&lt;br&gt;auth_request&lt;br&gt;-&amp;gt; /auth/verify (method in a header)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="300" y="490" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;auth service :8446&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /auth/login -&amp;gt; cookie&lt;br&gt;POST /auth/token -&amp;gt; token&lt;br&gt;GET /auth/verify (Basic cached 5 min)&lt;br&gt;&lt;br&gt;throttle: 5 per name, 50 per address&lt;br&gt;(address = last X-Forwarded-For hop,&lt;br&gt;client-controlled when direct: S-20)&lt;br&gt;&lt;br&gt;signs with session.key (Ed25519)&lt;br&gt;8 hours; jti minted, never checked&lt;br&gt;sign-out deletes the cookie only (S-18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="130" width="230" height="440" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;retail Postgres :5432&lt;/b&gt;&lt;br&gt;no certificate, ssl off&lt;br&gt;&lt;br&gt;pg_hba (ldap_hba.sh:76-77):&lt;br&gt;host all reader,rolesync all scram&lt;br&gt;host nl2sql_retail +nl2sql_ldap all ldap&lt;br&gt;  ldapserver=nl2sql-ldap ldaptls=1&lt;br&gt;host all all all scram  (image's own)&lt;br&gt;&lt;br&gt;the ldap method is AuthenticationCleartextPassword:&lt;br&gt;the client sends the password as typed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="230" height="300" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;OpenLDAP (nl2sql-ldap) :389&lt;/b&gt;&lt;br&gt;StartTLS required for a simple bind&lt;br&gt;(security simple_bind=64)&lt;br&gt;Argon2 hash; lockout 5 / 900 s&lt;br&gt;replica: bind passed to the primary&lt;br&gt;(no StartTLS by default: S-23)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="270" height="180" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;API / console / review&lt;/b&gt;&lt;br&gt;Guard.identify -&amp;gt; Identity&lt;br&gt;verifies with session.pub (authkeys)&lt;br&gt;roles re-read via pg_has_role &amp;lt;= 60 s&lt;br&gt;SET LOCAL ROLE &amp;lt;person&amp;gt;&lt;br&gt;-- same SELECT as the reader; no RLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="920" y="470" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;Static service token (if set)&lt;/b&gt;&lt;br&gt;API_TOKEN / REVIEW_TOKEN / CONSOLE_TOKEN&lt;br&gt;Identity(kind=service, roles=every role&lt;br&gt;of the service, name='service token')&lt;br&gt;author falls back to X-Reviewer (S-19)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=top;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1250" y="470" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="n23" value="1. POST /auth/login (TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n16"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell>
<mxCell id="n24" value="2. proxied, TLS verified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n16" target="n18"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell>
<mxCell id="n25" value="3. connect as the person&lt;br&gt;sslmode=prefer -&amp;gt; plain TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n19"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
<mxCell id="n26" value="4. simple bind over StartTLS&lt;br&gt;LDAPTLS_CACERT verifies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;fontColor=#4f7a45;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n20"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
<mxCell id="n27" value="5. Set-Cookie nl2sql_session&lt;br&gt;HttpOnly SameSite=Strict Secure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;fontColor=#9673a6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n16"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="16" as="offset"/></mxGeometry></mxCell>
<mxCell id="n28" value="6. /v1/... with the cookie&lt;br&gt;(cross-site write check)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontColor=#9673a6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n16" target="n21"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="300"/><mxPoint x="860" y="300"/><mxPoint x="860" y="515"/></Array><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
<mxCell id="n29" value="POST /auth/token (TLS; X-Forwarded-For is the client's)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n18"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell>
<mxCell id="n30" value="Authorization: Bearer &amp;lt;session&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;fontColor=#9673a6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n21"><mxGeometry x="0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="330"/><mxPoint x="230" y="560"/><mxPoint x="880" y="560"/></Array><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell>
<mxCell id="n31" value="connect as the person over the LAN: clear-text password to a server with no TLS (S-16)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n19"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="386"/><mxPoint x="560" y="110"/><mxPoint x="1035" y="110"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
<mxCell id="n32" value="Basic (TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n17"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell>
<mxCell id="n33" value="auth_request: Basic -&amp;gt; sign_in (then 3, 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.88;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n18"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell>
<mxCell id="n34" value="Bearer / X-API-Key&lt;br&gt;hmac.compare_digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n22" target="n21"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
<mxCell id="n35" value="What is right: the browser's hop, the proxy's hop and the directory's hop are all TLS with the certificate verified; the session cannot be forged (fixed header, Ed25519, issuer and audience checked); a removed person is signed out within a minute. What is not: the one hop that carries the password as typed, auth service to Postgres, is plain TCP because the server has no certificate and sslmode=prefer accepts that silently -- and the same 'host ... ldap' rule answers a connection from anywhere on the network." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1480" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
