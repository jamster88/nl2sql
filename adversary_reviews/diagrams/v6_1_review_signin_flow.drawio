<mxfile host="Electron" modified="2026-10-04T00:00:00.000Z" agent="nl2sql v6_1_review diagram generator" version="31.4.5" type="device">
  <diagram id="v6_1_signin_flow" name="v6_1_signin_flow">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="760" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
