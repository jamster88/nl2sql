<mxCell id="n34" value="drop_reasons or missing_assumptions: back to narrate once (narration_retries &amp;lt; MAX_NARRATION_RETRIES = 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#7a5a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n13"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1292" y="190"/><mxPoint x="1172" y="190"/></Array><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
<mxCell id="n35" value="narrator exception -&amp;gt; retrieval_errors['narrator'] (a Stage-1 reducer key, graph.py:1087)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1340" y="395" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="n36" value="Consequence (I-02). After a semantic_issue sends a run to repair, the new attempt reaches narrate with the old attempt's audit still in state. If that report had any drop_reasons or missing_assumptions, the first narration of the new result is treated as a rewrite (rung bumped, trace says 'rewritten', narration_retries = 1), and the new result's own audit can then send nothing back: dropped claims are dropped on the first pass. Spec 7.3 rule 4 says 'once'; the code implements once per run, not once per attempt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;spacing=4;spacingLeft=6;spacingRight=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="1480" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
