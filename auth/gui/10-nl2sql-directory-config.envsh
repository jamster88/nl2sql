#!/bin/sh
# The decisions nginx cannot make for itself, made before its templates are
# substituted -- and one it must not be asked to: whether to serve at all.
#
# Sourced rather than executed -- hence `.envsh`, which the nginx image's
# entrypoint treats differently -- because it exports variables the envsubst
# step after it has to see.

set -eu

# 1. Whether this page may exist. A replica's people and groups come from its
#    primary and are edited there; a page that offered to edit them would be
#    offering what the replica refuses. So beside a replica it does not
#    start, whatever started it.
case "${LDAP_MODE:-standalone}" in
    replica)
        echo "nl2sql-directory-gui: LDAP_MODE=replica. A replica's people are edited on its" >&2
        echo "  primary directory and copied here, so this page is not served beside one." >&2
        exit 1
        ;;
esac

# 2. The Authorization header: always none. The browser's session cookie is
#    the only credential this page's calls carry; an empty value makes nginx
#    drop any header a browser sent.
export DIRECTORY_AUTH_HEADER=""

# 3. Whether there is a certificate to verify the auth service with. Read
#    while nginx parses its config, so a missing one stops the container --
#    with a BIO error that says nothing about why. The destination is
#    overridable only for the tests.
tls_conf="${NGINX_DIRECTORY_UPSTREAM_TLS_CONF:-/etc/nginx/nl2sql-directory-upstream-tls.conf}"
case "${DIRECTORY_UPSTREAM}" in
    https://*)
        if [ ! -r "${DIRECTORY_CACERT}" ]; then
            echo "nl2sql-directory-gui: DIRECTORY_UPSTREAM is ${DIRECTORY_UPSTREAM} but there is no" >&2
            echo "  readable certificate at DIRECTORY_CACERT=${DIRECTORY_CACERT} to verify it." >&2
            echo "  It is the stack's CA certificate, which the pki service writes beside this" >&2
            echo "  page's own certificate -- so this usually means that volume is not mounted here." >&2
            exit 1
        fi
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-directory-config.envsh because DIRECTORY_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${DIRECTORY_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${DIRECTORY_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-directory-config.envsh. DIRECTORY_UPSTREAM is
# ${DIRECTORY_UPSTREAM} -- plain HTTP, so passwords cross this hop in clear
# text; that is only right behind something that terminates TLS itself.
TLSEOF
        ;;
esac

# 4. This page's own listener. HTTPS by default, because passwords are typed
#    into it; the certificate is this page's own, from the pki service. Off
#    (DIRECTORY_GUI_TLS_ENABLED=false) only behind something that terminates TLS.
server_conf="${NGINX_SERVER_TLS_CONF:-/etc/nginx/nl2sql-server-tls.conf}"
case "${DIRECTORY_GUI_TLS_ENABLED:-true}" in
    false|0|no|off)
        export DIRECTORY_GUI_LISTEN_TLS=""
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-directory-config.envsh. DIRECTORY_GUI_TLS_ENABLED=false:
# this page is plain HTTP, and so is every password typed into it.
TLSEOF
        ;;
    *)
        if [ ! -r "${DIRECTORY_GUI_TLS_CERT_FILE}" ] || [ ! -r "${DIRECTORY_GUI_TLS_KEY_FILE}" ]; then
            echo "nl2sql-directory-gui: DIRECTORY_GUI_TLS_ENABLED is on but ${DIRECTORY_GUI_TLS_CERT_FILE} or" >&2
            echo "  ${DIRECTORY_GUI_TLS_KEY_FILE} is not readable. They are this page's own, from the pki service" >&2
            echo "  (its TLS volume, mounted here); mount it, or set DIRECTORY_GUI_TLS_ENABLED=false" >&2
            echo "  behind something that terminates TLS itself." >&2
            exit 1
        fi
        export DIRECTORY_GUI_LISTEN_TLS=" ssl"
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-directory-config.envsh because DIRECTORY_GUI_TLS_ENABLED is on.
ssl_certificate ${DIRECTORY_GUI_TLS_CERT_FILE};
ssl_certificate_key ${DIRECTORY_GUI_TLS_KEY_FILE};
ssl_protocols TLSv1.2 TLSv1.3;
TLSEOF
        ;;
esac
