# The directory page's own server, and its one hop: the auth service.
#
# Everything this page calls is the auth service's -- `/auth/` for signing
# in, on its published port, and `/directory/` for the people and groups, on
# the port the service answers them on alone (AUTH_DIRECTORY_PORT), which is
# not published: only this page, inside the stack, reaches it. Both
# verified.
# It holds no token of its own: whoever uses this page is a signed-in member
# of nl2sql-admins, by their own session cookie, and the service checks that
# on every call.
#
# Never served beside a replica: a replica's people are its primary's, and
# the start-up script refuses to start this page when LDAP_MODE=replica.

# What the browser used, as the page should tell what is behind it (V6-56).
# nginx's own `$scheme` is `http` behind something that terminates TLS in
# front of this page (GUI_TLS_ENABLED=false), and a session cookie set from
# that is set without `Secure`. So a terminator's `X-Forwarded-Proto: https`
# is believed -- upward only: a client that claims https over http gets a
# cookie its browser will not send back over http, which costs only that
# client, and nothing here ever trusts a claim of `http`.
map $http_x_forwarded_proto $nl2sql_forwarded_proto {
    default $scheme;
    https   https;
}

server {
    listen ${DIRECTORY_GUI_PORT}${DIRECTORY_GUI_LISTEN_TLS};
    server_name _;

    # The certificate, when the page is HTTPS. Written by the start-up
    # script, which knows whether there is one.
    include /etc/nginx/nl2sql-server-tls.conf;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # One page, so any path that is not a file is still the page.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- the auth service ---------------------------------------------------

    location /auth/ {
        # Resolved per request rather than once at start-up, as in the other
        # interfaces: a literal upstream is looked up while nginx parses its
        # config, so the page could not start before the service, and would
        # keep talking to its old address after a restart.
        resolver ${DIRECTORY_GUI_RESOLVER} valid=10s ipv6=off;
        set $upstream ${DIRECTORY_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nl2sql_forwarded_proto;
        # Host and port, which the service's cross-site check compares a
        # cookie-carrying write's Origin with: another port is another site.
        proxy_set_header X-Forwarded-Host $http_host;
        # Always empty, so always dropped: the session cookie is the only
        # credential that crosses this hop.
        proxy_set_header Authorization "${DIRECTORY_AUTH_HEADER}";
        proxy_set_header Connection "";

        # Verified, as every hop in this stack is. Written at start-up from
        # the upstream's own scheme.
        include /etc/nginx/nl2sql-directory-upstream-tls.conf;

        proxy_read_timeout ${DIRECTORY_READ_TIMEOUT};
    }

    # The directory's own API, on its own port (V6-58).
    location /directory/ {
        # Resolved per request, as above.
        resolver ${DIRECTORY_GUI_RESOLVER} valid=10s ipv6=off;
        set $upstream ${DIRECTORY_API_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nl2sql_forwarded_proto;
        # Host and port, which the service's cross-site check compares a
        # cookie-carrying write's Origin with: another port is another site.
        proxy_set_header X-Forwarded-Host $http_host;
        # Always empty, so always dropped: the session cookie is the only
        # credential that crosses this hop.
        proxy_set_header Authorization "${DIRECTORY_AUTH_HEADER}";
        proxy_set_header Connection "";

        # Verified, as every hop in this stack is. Written at start-up from
        # the upstream's own scheme.
        include /etc/nginx/nl2sql-directory-upstream-tls.conf;

        # An import is a file sent as JSON; a few thousand people as CSV is
        # well under this, and the service refuses anything past 5 MB itself.
        client_max_body_size 6m;
        proxy_read_timeout ${DIRECTORY_READ_TIMEOUT};
    }
}
