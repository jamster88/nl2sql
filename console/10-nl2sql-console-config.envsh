#!/bin/sh
# The four decisions nginx cannot make for itself, made before its templates
# are substituted.
#
# Sourced rather than executed -- hence `.envsh`, which the nginx image's
# entrypoint treats differently -- because the first of the two exports a
# variable the envsubst step after it has to see.

set -eu

# 1. The Authorization header.
#
#    The point of the indirection is the empty case: nginx drops a header
#    whose value is the empty string, so a deployment with no token sends no
#    Authorization header at all rather than "Bearer " with nothing after it.
#    With sign-in on (AUTH_ENABLED=true) the proxy adds none: the browser's
#    own session cookie goes through, and the person it names is who did it.
#    A token here would let every visitor act as the service.
#
#    On unless switched off by name: an unset or misspelt value is sign-in
#    on, so a page started outside compose is not open by accident.
case "${AUTH_ENABLED:-true}" in
    false|0|no|off)
        echo "nl2sql-console-gui: sign-in is off (AUTH_ENABLED=false): every visitor to this page can run SQL." >&2
        if [ -n "${CONSOLE_TOKEN:-}" ]; then
            export CONSOLE_AUTH_HEADER="Bearer ${CONSOLE_TOKEN}"
        else
            export CONSOLE_AUTH_HEADER=""
        fi
        ;;
    *) export CONSOLE_AUTH_HEADER="" ;;
esac

# 2. Whether there is a certificate to verify.
#
#    `proxy_ssl_trusted_certificate` is read while nginx parses its config,
#    so naming a file that is not there stops the container from starting,
#    with a BIO error that says nothing about why. That is the right outcome
#    for an HTTPS upstream; the message is just worth replacing with one
#    that says what to do.
#
#    It is the wrong outcome behind CONSOLE_TLS_ENABLED=false, where the
#    console serves plain HTTP and there is no certificate anywhere.
#
#    The destination is overridable only so this script can be run against a
#    temporary directory by the test suite. Nothing sets it in the image.
tls_conf="${NGINX_CONSOLE_UPSTREAM_TLS_CONF:-/etc/nginx/nl2sql-console-upstream-tls.conf}"

case "${CONSOLE_UPSTREAM}" in
    https://*)
        if [ ! -r "${CONSOLE_CACERT}" ]; then
            echo "nl2sql-console-gui: CONSOLE_UPSTREAM is ${CONSOLE_UPSTREAM} but there is no" >&2
            echo "  readable certificate at CONSOLE_CACERT=${CONSOLE_CACERT} to verify it." >&2
            echo "  It is the stack's CA certificate, which the pki service writes beside this" >&2
            echo "  page's own certificate -- so this usually means that volume is not mounted here." >&2
            exit 1
        fi
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-console-config.envsh because CONSOLE_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${CONSOLE_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${CONSOLE_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-console-config.envsh. CONSOLE_UPSTREAM is
# ${CONSOLE_UPSTREAM} -- plain HTTP, so there is no certificate to verify.
# Every query and every row the browser is sent crosses in clear text.
TLSEOF
        ;;
esac

# 3. The sign-in hop: `/auth/` goes to the auth service, which presents a
#    certificate of its own from the stack's CA. Checked as the upstream above is, for the
#    same reason; the destination is overridable for the tests alone.
auth_conf="${NGINX_AUTH_TLS_CONF:-/etc/nginx/nl2sql-auth-tls.conf}"
case "${AUTH_UPSTREAM}" in
    https://*)
        if [ ! -r "${AUTH_CACERT}" ]; then
            echo "nl2sql-console-gui: AUTH_UPSTREAM is ${AUTH_UPSTREAM} but there is no" >&2
            echo "  readable certificate at AUTH_CACERT=${AUTH_CACERT} to verify it." >&2
            echo "  It is the stack's CA certificate, which the pki service writes beside this" >&2
            echo "  page's own certificate -- so this usually means that volume is not mounted here." >&2
            exit 1
        fi
        cat > "$auth_conf" <<TLSEOF
# Written by 10-nl2sql-console-config.envsh because AUTH_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${AUTH_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${AUTH_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$auth_conf" <<TLSEOF
# Written by 10-nl2sql-console-config.envsh. AUTH_UPSTREAM is ${AUTH_UPSTREAM} -- plain
# HTTP, so passwords cross this hop in clear text; that is only right behind
# something that terminates TLS itself.
TLSEOF
        ;;
esac

# 4. This page's own listener. HTTPS by default, because a password is typed
#    into it; the certificate is this page's own, from the pki service. Off
#    (CONSOLE_GUI_TLS_ENABLED=false) only behind something that terminates TLS.
server_conf="${NGINX_SERVER_TLS_CONF:-/etc/nginx/nl2sql-server-tls.conf}"
case "${CONSOLE_GUI_TLS_ENABLED:-true}" in
    false|0|no|off)
        export CONSOLE_GUI_LISTEN_TLS=""
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-console-config.envsh. CONSOLE_GUI_TLS_ENABLED=false: this page is
# plain HTTP, and so is every password typed into it.
TLSEOF
        ;;
    *)
        if [ ! -r "${CONSOLE_GUI_TLS_CERT_FILE}" ] || [ ! -r "${CONSOLE_GUI_TLS_KEY_FILE}" ]; then
            echo "nl2sql-console-gui: CONSOLE_GUI_TLS_ENABLED is on but ${CONSOLE_GUI_TLS_CERT_FILE} or" >&2
            echo "  ${CONSOLE_GUI_TLS_KEY_FILE} is not readable. They are this page's own, from the pki service" >&2
            echo "  (its TLS volume, mounted here); mount it, or set CONSOLE_GUI_TLS_ENABLED=false" >&2
            echo "  behind something that terminates TLS itself." >&2
            exit 1
        fi
        export CONSOLE_GUI_LISTEN_TLS=" ssl"
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-console-config.envsh because CONSOLE_GUI_TLS_ENABLED is on.
ssl_certificate ${CONSOLE_GUI_TLS_CERT_FILE};
ssl_certificate_key ${CONSOLE_GUI_TLS_KEY_FILE};
ssl_protocols TLSv1.2 TLSv1.3;
TLSEOF
        ;;
esac
