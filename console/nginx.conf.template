# The console interface's own server, and the hop that makes a browser's life
# simple.
#
# The same three problems the other interfaces' proxies solve: the console
# presents the API's self-signed certificate, which a browser will not
# accept; its token must not reach the browser; and a second origin turns
# every request into a CORS negotiation the console does not offer.
#
# No event stream here, so no buffering rules. What matters instead is the
# read timeout: a query can take as long as the agent's statement timeout,
# and a proxy that gives up first cuts off an answer that is coming.

server {
    listen ${CONSOLE_GUI_PORT}${CONSOLE_GUI_LISTEN_TLS};
    server_name _;

    # The certificate, when the page is HTTPS. Written by the start-up
    # script, which knows whether there is one.
    include /etc/nginx/nl2sql-server-tls.conf;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # One page, so any path that is not a file is still the page.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- the console -----------------------------------------------------

    # Sign-in: the auth service. Its session cookie comes back through here,
    # so it belongs to this page's host -- and, a cookie being scoped by host
    # rather than port, to every page of the stack served from it.
    location /auth/ {
        resolver ${CONSOLE_GUI_RESOLVER} valid=10s ipv6=off;
        set $auth_upstream ${AUTH_UPSTREAM};
        proxy_pass $auth_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Connection "";
        include /etc/nginx/nl2sql-auth-tls.conf;
    }

    location ~ ^/(v1|healthz|readyz|openapi\.json) {
        # Resolved per request rather than once at start-up: a literal
        # upstream is looked up while nginx parses its config and cached for
        # the life of the process, which means refusing to start before the
        # console is up and talking to a stale address after it restarts.
        resolver ${CONSOLE_GUI_RESOLVER} valid=10s ipv6=off;
        set $upstream ${CONSOLE_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Host and port, which the service's cross-site check compares a
        # cookie-carrying write's Origin with: another port is another site.
        proxy_set_header X-Forwarded-Host $http_host;
        # Empty when no token is configured, and nginx omits a header whose
        # value is empty -- so the unauthenticated deployment sends nothing
        # rather than the word "Bearer" on its own.
        proxy_set_header Authorization "${CONSOLE_AUTH_HEADER}";
        proxy_set_header Connection "";

        # Verified rather than skipped: this hop crosses a container network.
        # Included rather than written here because the directives are wrong
        # when CONSOLE_UPSTREAM is plain HTTP and there is no certificate to
        # name -- see 10-nl2sql-console-config.envsh.
        include /etc/nginx/nl2sql-console-upstream-tls.conf;

        # Longer than the agent's statement timeout, which is the longest a
        # query here can run before the database cancels it.
        proxy_read_timeout ${CONSOLE_READ_TIMEOUT};
        proxy_send_timeout ${CONSOLE_READ_TIMEOUT};
    }
}
