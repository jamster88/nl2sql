#!/bin/sh
# The four decisions nginx cannot make for itself, made before its templates
# are substituted -- the review interface's script, under this page's names.
#
# Sourced rather than executed -- hence `.envsh` -- because the first of the
# two exports a variable the envsubst step after it has to see.

set -eu

# 1. The Authorization header. Empty when there is no token, and nginx drops
#    a header whose value is empty. The token is the review service's, which
#    can rewrite the golden set and the snippets; it never reaches a browser.
#    With sign-in on (AUTH_ENABLED=true) the proxy adds none: the browser's
#    own session cookie goes through, and the person it names is who did it.
#    A token here would let every visitor act as the service.
case "${AUTH_ENABLED:-false}" in
    true|1|yes|on) export CURATE_AUTH_HEADER="" ;;
    *)
        if [ -n "${CURATE_TOKEN:-}" ]; then
            export CURATE_AUTH_HEADER="Bearer ${CURATE_TOKEN}"
        else
            export CURATE_AUTH_HEADER=""
        fi
        ;;
esac

# 2. Whether there is a certificate to verify. Naming a file that is not
#    there stops nginx from starting with an error that says nothing about
#    why, so it is checked here first; behind plain HTTP there is none.
#    The destination is overridable only so the test suite can run this
#    against a temporary directory.
tls_conf="${NGINX_CURATE_UPSTREAM_TLS_CONF:-/etc/nginx/nl2sql-curate-upstream-tls.conf}"

case "${CURATE_UPSTREAM}" in
    https://*)
        if [ ! -r "${CURATE_CACERT}" ]; then
            echo "nl2sql-curate-gui: CURATE_UPSTREAM is ${CURATE_UPSTREAM} but there is no" >&2
            echo "  readable certificate at CURATE_CACERT=${CURATE_CACERT} to verify it." >&2
            echo "  The review service presents the certificate the agent API generates," >&2
            echo "  so this usually means the API has not started yet, or the apitls" >&2
            echo "  volume is not mounted here." >&2
            exit 1
        fi
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-curate-config.envsh because CURATE_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${CURATE_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${CURATE_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-curate-config.envsh. CURATE_UPSTREAM is
# ${CURATE_UPSTREAM} -- plain HTTP, so there is no certificate to verify.
# Everything the curator's browser sends, including their edits to the
# golden set and the snippets, crosses in clear text.
TLSEOF
        ;;
esac

# 3. The sign-in hop: `/auth/` goes to the auth service, which presents the
#    same certificate as the API. Checked as the upstream above is, for the
#    same reason; the destination is overridable for the tests alone.
auth_conf="${NGINX_AUTH_TLS_CONF:-/etc/nginx/nl2sql-auth-tls.conf}"
case "${AUTH_UPSTREAM}" in
    https://*)
        if [ ! -r "${AUTH_CACERT}" ]; then
            echo "nl2sql-curate-gui: AUTH_UPSTREAM is ${AUTH_UPSTREAM} but there is no" >&2
            echo "  readable certificate at AUTH_CACERT=${AUTH_CACERT} to verify it." >&2
            echo "  The auth service presents the certificate the agent API generates," >&2
            echo "  so this usually means the API has not started yet, or the apitls" >&2
            echo "  volume is not mounted here." >&2
            exit 1
        fi
        cat > "$auth_conf" <<TLSEOF
# Written by 10-nl2sql-curate-config.envsh because AUTH_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${AUTH_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${AUTH_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$auth_conf" <<TLSEOF
# Written by 10-nl2sql-curate-config.envsh. AUTH_UPSTREAM is ${AUTH_UPSTREAM} -- plain
# HTTP, so passwords cross this hop in clear text; that is only right behind
# something that terminates TLS itself.
TLSEOF
        ;;
esac

# 4. This page's own listener. HTTPS by default, because a password is typed
#    into it; the certificate is the API's, which covers localhost. Off
#    (CURATE_GUI_TLS_ENABLED=false) only behind something that terminates TLS.
server_conf="${NGINX_SERVER_TLS_CONF:-/etc/nginx/nl2sql-server-tls.conf}"
case "${CURATE_GUI_TLS_ENABLED:-true}" in
    false|0|no|off)
        export CURATE_GUI_LISTEN_TLS=""
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-curate-config.envsh. CURATE_GUI_TLS_ENABLED=false: this page is
# plain HTTP, and so is every password typed into it.
TLSEOF
        ;;
    *)
        if [ ! -r "${CURATE_GUI_TLS_CERT_FILE}" ] || [ ! -r "${CURATE_GUI_TLS_KEY_FILE}" ]; then
            echo "nl2sql-curate-gui: CURATE_GUI_TLS_ENABLED is on but ${CURATE_GUI_TLS_CERT_FILE} or" >&2
            echo "  ${CURATE_GUI_TLS_KEY_FILE} is not readable. They come from the apitls volume" >&2
            echo "  the API writes on its first start; mount it, or set CURATE_GUI_TLS_ENABLED=false" >&2
            echo "  behind something that terminates TLS itself." >&2
            exit 1
        fi
        export CURATE_GUI_LISTEN_TLS=" ssl"
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-curate-config.envsh because CURATE_GUI_TLS_ENABLED is on.
ssl_certificate ${CURATE_GUI_TLS_CERT_FILE};
ssl_certificate_key ${CURATE_GUI_TLS_KEY_FILE};
ssl_protocols TLSv1.2 TLSv1.3;
TLSEOF
        ;;
esac
