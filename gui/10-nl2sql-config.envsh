#!/bin/sh
# The four decisions nginx cannot make for itself, made before its templates
# are substituted.
#
# Sourced rather than executed -- hence `.envsh`, which the nginx image's
# entrypoint treats differently -- because two of them export variables that
# the envsubst step after this has to see.

set -eu

# 1. The Authorization header the proxy adds to every API call.
#
#    With sign-in on (AUTH_ENABLED=true) it adds none: the browser's own
#    session cookie goes through, and the person it names is who asked. A
#    proxy-held token there would sign every visitor in as the service.
#
#    With sign-in off it is the API token, as it always was. The point of
#    the indirection is the empty case: nginx drops a header whose value is
#    the empty string, so no token sends no Authorization header at all
#    rather than "Bearer " with nothing after it.
case "${AUTH_ENABLED:-false}" in
    true|1|yes|on) export API_AUTH_HEADER="" ;;
    *)
        if [ -n "${API_TOKEN:-}" ]; then
            export API_AUTH_HEADER="Bearer ${API_TOKEN}"
        else
            export API_AUTH_HEADER=""
        fi
        ;;
esac

# Writes the directives that verify an upstream into a file the template
# includes: `proxy_ssl_trusted_certificate` is read while nginx parses its
# config, so a file that is not there stops the container -- with a BIO
# error that says nothing about why. For HTTPS that is the right outcome,
# with a better message; for a plain-HTTP upstream (TLS off on the service,
# behind something that terminates it) there is no certificate to name.
#
#   upstream_tls NAME URL CACERT_NAME CACERT SSL_NAME FILE
upstream_tls() {
    case "$2" in
        https://*)
            if [ ! -r "$4" ]; then
                echo "nl2sql-gui: $1 is $2 but there is no readable" >&2
                echo "  certificate at $3=$4 to verify it against." >&2
                echo "  Under compose this file comes from the apitls volume, which the API" >&2
                echo "  writes on its first start -- so this usually means the API has not" >&2
                echo "  started yet, or the volume is not mounted." >&2
                exit 1
            fi
            cat > "$6" <<EOF
# Written by 10-nl2sql-config.envsh because $1 is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate $4;
proxy_ssl_server_name on;
proxy_ssl_name $5;
EOF
            ;;
        *)
            cat > "$6" <<EOF
# Written by 10-nl2sql-config.envsh. $1 is $2 -- plain HTTP, so there is
# no certificate to verify. What crosses this hop is in clear text; that is
# only right behind something that terminates TLS itself.
EOF
            ;;
    esac
}

# 2. The API hop. The destinations are overridable only so this script can
#    be run against a temporary directory by the test suite.
upstream_tls API_UPSTREAM "${API_UPSTREAM}" API_CACERT "${API_CACERT}" "${API_SSL_NAME}" \
    "${NGINX_UPSTREAM_TLS_CONF:-/etc/nginx/nl2sql-upstream-tls.conf}"

# 3. The sign-in hop: `/auth/` goes to the auth service, which presents the
#    same certificate as the API.
upstream_tls AUTH_UPSTREAM "${AUTH_UPSTREAM}" AUTH_CACERT "${AUTH_CACERT}" "${AUTH_SSL_NAME}" \
    "${NGINX_AUTH_TLS_CONF:-/etc/nginx/nl2sql-auth-tls.conf}"

# 4. This page's own listener. HTTPS by default, because the page carries a
#    password; the certificate is the API's, which covers localhost. Off
#    (GUI_TLS_ENABLED=false) only behind something that terminates TLS.
server_tls="${NGINX_SERVER_TLS_CONF:-/etc/nginx/nl2sql-server-tls.conf}"
case "${GUI_TLS_ENABLED:-true}" in
    false|0|no|off)
        export GUI_LISTEN_TLS=""
        cat > "$server_tls" <<EOF
# Written by 10-nl2sql-config.envsh. GUI_TLS_ENABLED=false: this page is
# plain HTTP, and so is every password typed into it.
EOF
        ;;
    *)
        if [ ! -r "${GUI_TLS_CERT_FILE}" ] || [ ! -r "${GUI_TLS_KEY_FILE}" ]; then
            echo "nl2sql-gui: GUI_TLS_ENABLED is on but ${GUI_TLS_CERT_FILE} or" >&2
            echo "  ${GUI_TLS_KEY_FILE} is not readable. They come from the apitls volume" >&2
            echo "  the API writes on its first start; mount it, or set GUI_TLS_ENABLED=false" >&2
            echo "  behind something that terminates TLS itself." >&2
            exit 1
        fi
        export GUI_LISTEN_TLS=" ssl"
        cat > "$server_tls" <<EOF
# Written by 10-nl2sql-config.envsh because GUI_TLS_ENABLED is on.
ssl_certificate ${GUI_TLS_CERT_FILE};
ssl_certificate_key ${GUI_TLS_KEY_FILE};
ssl_protocols TLSv1.2 TLSv1.3;
EOF
        ;;
esac
