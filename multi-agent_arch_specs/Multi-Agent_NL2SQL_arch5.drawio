        <mxCell id="c62" value="STAGE 4 &amp;#8212; PRESENTATION AND AUDIT  (state: formatting)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2194" width="1160" height="212" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Visual Formatter&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- result shape -&amp;gt; scalar / bar / line / grouped bar / scatter / table&lt;br&gt;- intent breaks ties; emits ChartSpec + markdown table&lt;br&gt;- reads state; calls no upstream agent" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c62"><mxGeometry x="25" y="56" width="350" height="116" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Insight Narrator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM&lt;/font&gt;&lt;br&gt;- structured claims: {text, value, cells, formula}&lt;br&gt;- sees the capped result set, the chart spec,&lt;br&gt;- the top exemplar's reasoning target, and the&lt;br&gt;- assumptions, each of which it must state" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c62"><mxGeometry x="405" y="56" width="350" height="116" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Audit Checker&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- every claim value == a cell, or formula over cells&lt;br&gt;- every assumption stated (FY default, etc.)&lt;br&gt;- sensitive columns: aggregates only&lt;br&gt;- unsupported claim -&amp;gt; narrator once, then dropped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c62"><mxGeometry x="785" y="56" width="350" height="116" as="geometry"/></mxCell>
