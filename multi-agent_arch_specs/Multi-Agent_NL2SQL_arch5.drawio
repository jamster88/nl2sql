        <mxCell id="c27" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Context Aggregator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;join, no LLM&lt;/font&gt;&lt;br&gt;- fan-in of the four branches; dedupe tables, apply FK closure and the cap&lt;br&gt;- fetch schema + sample rows; trim rules and exemplars to their budgets" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c15"><mxGeometry x="330" y="362" width="500" height="80" as="geometry"/></mxCell>
