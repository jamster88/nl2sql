        <mxCell id="c15" value="STAGE 1 &amp;#8212; INTAKE AND CONTEXT GATHERING  (state: gathering; four retrievers run in parallel)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="1160" height="470" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Supervisor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM&lt;/font&gt;&lt;br&gt;- in-domain? prompt-injected? ambiguous?&lt;br&gt;- intent: lookup / aggregate / compare / trend / narrative&lt;br&gt;- entities + measure + period -&amp;gt; answer contract&lt;br&gt;- one structured call; the only input screen" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c15"><mxGeometry x="410" y="50" width="340" height="110" as="geometry"/></mxCell>
