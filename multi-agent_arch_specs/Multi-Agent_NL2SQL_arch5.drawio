        <mxCell id="e18" value="verdict &amp;#8800; proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Schema Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- DDL-chunk vectors (ddl_index) top-6&lt;br&gt;- + tables named by knowledge and exemplars&lt;br&gt;- + foreign-key closure from pg_constraint&lt;br&gt;- cap 10 tables; no model call" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="16" y="196" width="262" height="116" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Literal Matcher&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- literal catalog: text columns with&lt;br&gt;- &amp;lt;= 500 distinct values, trigram-indexed&lt;br&gt;- pg_trgm word_similarity (difflib fallback)&lt;br&gt;- phrase -&amp;gt; table.column = 'value'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="308" y="196" width="262" height="116" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Knowledge Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question vector vs data dictionary&lt;br&gt;- and business index chunks&lt;br&gt;- top-4 per collection&lt;br&gt;- best-effort: skipped if the store is down" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="600" y="196" width="262" height="116" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Example Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question 0.50 | BM25 keywords 0.35 |&lt;br&gt;- reasoning 0.15 -&amp;gt; score fusion&lt;br&gt;- -&amp;gt; grounding + MMR rerank -&amp;gt; top 3&lt;br&gt;- the v3 ensemble, unchanged" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="892" y="196" width="262" height="116" as="geometry"/></mxCell>
