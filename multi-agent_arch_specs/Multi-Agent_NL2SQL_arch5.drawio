        <mxCell id="c32" value="STAGE 2 &amp;#8212; SYNTHESIS  (state: compiling)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="824" width="1160" height="172" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;SQL Generator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM, multi-shot&lt;/font&gt;&lt;br&gt;- system: rules + dialect + pruned schema and sample rows&lt;br&gt;- turns: up to 3 exemplars replayed as human/assistant pairs (bare SQL answers)&lt;br&gt;- human: knowledge + literal map + intent framing + answer contract + question + repair hint (on retries)&lt;br&gt;- the only agent that writes SQL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c32"><mxGeometry x="240" y="48" width="680" height="108" as="geometry"/></mxCell>
        <mxCell id="e34" value="pruned DDL + literal map + rules + exemplars" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" value="STAGE 3 &amp;#8212; VALIDATION AND REPAIR LOOP  (state: guarding; one counter, attempts, shared by every failure, including a result that ran but does not answer the question)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1036" width="1160" height="1118" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Static Validator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;pglast AST&lt;/font&gt;&lt;br&gt;- exactly one statement; SelectStmt only&lt;br&gt;- no writing CTE, no SELECT INTO, function denylist&lt;br&gt;- every relation in the table allowlist&lt;br&gt;- regex prefix check first, as a free pre-filter" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c35"><mxGeometry x="70" y="48" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c37" value="AST&lt;br&gt;passes?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c35"><mxGeometry x="200" y="180" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Planner Gate&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;EXPLAIN, never ANALYZE&lt;/font&gt;&lt;br&gt;- EXPLAIN (FORMAT JSON) in a READ ONLY txn&lt;br&gt;- surfaces unknown columns, casts, GROUP BY&lt;br&gt;- Plan.Total Cost &amp;lt;= MAX_PLAN_COST" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c35"><mxGeometry x="70" y="306" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c39" value="plan ok?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c35"><mxGeometry x="200" y="438" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Safe Executor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- reader role; SET TRANSACTION READ ONLY&lt;br&gt;- SET LOCAL statement_timeout; row cap&lt;br&gt;- SET ROLE principal for RLS, when present" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c35"><mxGeometry x="70" y="564" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c41" value="ran?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c35"><mxGeometry x="200" y="696" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completeness Reviewer&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rules, then one LLM reflection&lt;/font&gt;&lt;br&gt;- R1 a label beside every key (sku_id -&amp;gt; product_name)&lt;br&gt;- R2 a ranked list shows the measure it was ranked by&lt;br&gt;- R3 the period is stated; default = latest complete FY -&amp;gt; assumptions&lt;br&gt;- R4 the row count fits the ask (top 10 -&amp;gt; 10 rows)&lt;br&gt;- then one reflection: what would the reader ask next? schema columns only&lt;br&gt;- same-result guard: never sends one gap back twice" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c35"><mxGeometry x="70" y="822" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="c43" value="answers the&lt;br&gt;question?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c35"><mxGeometry x="200" y="1006" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Repair Agent&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;classifier first; LLM only if unclassified&lt;/font&gt;&lt;br&gt;- error class -&amp;gt; hint (syntax position, nearest column,&lt;br&gt;- GROUP BY, cast, cost, timeout, audit, missing columns)&lt;br&gt;- appends {sql, issues} to attempt_history&lt;br&gt;- attempts += 1; never writes SQL itself" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c35"><mxGeometry x="690" y="306" width="430" height="118" as="geometry"/></mxCell>
        <mxCell id="c45" value="attempts&lt;br&gt;&amp;lt; max (7)?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c35"><mxGeometry x="825" y="480" width="160" height="96" as="geometry"/></mxCell>
