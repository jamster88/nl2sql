        <mxCell id="c26" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Example Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question 0.50 | BM25 keywords 0.35 |&lt;br&gt;- reasoning 0.15 -&amp;gt; score fusion&lt;br&gt;- -&amp;gt; grounding + MMR rerank -&amp;gt; top 3&lt;br&gt;- the v3 ensemble, unchanged" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c19"><mxGeometry x="892" y="196" width="262" height="116" as="geometry"/></mxCell>
