        <mxCell id="c24" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Literal Matcher&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- literal catalog: text columns with&lt;br&gt;- &amp;lt;= 500 distinct values, trigram-indexed&lt;br&gt;- pg_trgm word_similarity (difflib fallback)&lt;br&gt;- phrase -&amp;gt; table.column = 'value'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c19"><mxGeometry x="308" y="196" width="262" height="116" as="geometry"/></mxCell>
