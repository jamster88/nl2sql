        <mxCell id="c37" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;SQL Generator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM, multi-shot&lt;/font&gt;&lt;br&gt;- system: rules + dialect + pruned schema and sample rows&lt;br&gt;- turns: up to 3 exemplars replayed as human/assistant pairs (bare SQL answers)&lt;br&gt;- human: knowledge + literal map + intent framing + answer contract + question + repair hint (on retries)&lt;br&gt;- the only agent that writes SQL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c36"><mxGeometry x="240" y="48" width="680" height="108" as="geometry"/></mxCell>
