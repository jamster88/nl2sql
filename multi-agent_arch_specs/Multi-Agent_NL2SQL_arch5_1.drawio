        <mxCell id="c39" value="STAGE 3 &amp;#8212; VALIDATION AND REPAIR LOOP  (state: guarding; one counter, attempts, shared by every failure, including a result that ran but does not answer the question)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1148" width="1160" height="1118" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Static Validator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;pglast AST&lt;/font&gt;&lt;br&gt;- exactly one statement; SelectStmt only&lt;br&gt;- no writing CTE, no SELECT INTO, function denylist&lt;br&gt;- every relation in the table allowlist&lt;br&gt;- regex prefix check first, as a free pre-filter" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c39"><mxGeometry x="70" y="48" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c41" value="AST&lt;br&gt;passes?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c39"><mxGeometry x="200" y="180" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Planner Gate&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;EXPLAIN, never ANALYZE&lt;/font&gt;&lt;br&gt;- EXPLAIN (FORMAT JSON) in a READ ONLY txn&lt;br&gt;- surfaces unknown columns, casts, GROUP BY&lt;br&gt;- Plan.Total Cost &amp;lt;= MAX_PLAN_COST" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c39"><mxGeometry x="70" y="306" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c43" value="plan ok?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c39"><mxGeometry x="200" y="438" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Safe Executor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- reader role; SET TRANSACTION READ ONLY&lt;br&gt;- SET LOCAL statement_timeout; row cap&lt;br&gt;- SET ROLE principal for RLS, when present" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c39"><mxGeometry x="70" y="564" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c45" value="ran?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c39"><mxGeometry x="200" y="696" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completeness Reviewer&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rules, then one LLM reflection&lt;/font&gt;&lt;br&gt;- R1 a label beside every key (sku_id -&amp;gt; product_name)&lt;br&gt;- R2 a ranked list shows the measure it was ranked by&lt;br&gt;- R3 the period is stated; default = latest complete FY -&amp;gt; assumptions&lt;br&gt;- R4 the row count fits the ask (top 10 -&amp;gt; 10 rows)&lt;br&gt;- then one reflection: what would the reader ask next? schema columns only&lt;br&gt;- same-result guard: never sends one gap back twice" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c39"><mxGeometry x="70" y="822" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="c47" value="answers the&lt;br&gt;question?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c39"><mxGeometry x="200" y="1006" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Repair Agent&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;classifier first; LLM only if unclassified&lt;/font&gt;&lt;br&gt;- error class -&amp;gt; hint (syntax position, nearest column,&lt;br&gt;- GROUP BY, cast, cost, timeout, audit, missing columns)&lt;br&gt;- appends {sql, issues} to attempt_history&lt;br&gt;- attempts += 1; never writes SQL itself" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c39"><mxGeometry x="690" y="306" width="430" height="118" as="geometry"/></mxCell>
        <mxCell id="c49" value="attempts&lt;br&gt;&amp;lt; max (7)?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c39"><mxGeometry x="825" y="480" width="160" height="96" as="geometry"/></mxCell>
        <mxCell id="c50" value="Give up: last SQL + full attempt history" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c39"><mxGeometry x="690" y="640" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="e51" value="raw SQL" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c37" target="c40"><mxGeometry relative="1" x="-0.85" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e53" value="yes" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e55" value="yes" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e57" value="no: static issue" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e58" value="no: planner error / over budget" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e59" value="no: runtime error / timeout" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c48"><mxGeometry relative="1" x="-0.55" as="geometry"><Array as="points"><mxPoint x="670" y="1889"/><mxPoint x="670" y="1542"/></Array></mxGeometry></mxCell>
        <mxCell id="e60" value="yes: result set" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e62" value="no: incomplete (missing columns, wrong period or count)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" x="-0.6" as="geometry"><Array as="points"><mxPoint x="700" y="2199"/><mxPoint x="700" y="1560"/></Array></mxGeometry></mxCell>
        <mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e64" value="no" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e65" value="yes: regenerate with the hint" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="1673"/><mxPoint x="1240" y="1032"/></Array></mxGeometry></mxCell>
        <mxCell id="c66" value="STAGE 4 &amp;#8212; PRESENTATION AND AUDIT  (state: formatting)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2306" width="1160" height="212" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Visual Formatter&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- result shape -&amp;gt; scalar / bar / line / grouped bar / scatter / table&lt;br&gt;- intent breaks ties; emits ChartSpec + markdown table&lt;br&gt;- reads state; calls no upstream agent" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c66"><mxGeometry x="25" y="56" width="350" height="116" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Insight Narrator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM&lt;/font&gt;&lt;br&gt;- structured claims: {text, value, cells, formula}&lt;br&gt;- sees the capped result set, the chart spec,&lt;br&gt;- the top exemplar's reasoning target, and the&lt;br&gt;- assumptions, each of which it must state" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c66"><mxGeometry x="405" y="56" width="350" height="116" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Audit Checker&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- every claim value == a cell, or formula over cells&lt;br&gt;- every assumption stated (FY default, etc.)&lt;br&gt;- sensitive columns: aggregates only&lt;br&gt;- unsupported claim -&amp;gt; narrator once, then dropped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c66"><mxGeometry x="785" y="56" width="350" height="116" as="geometry"/></mxCell>
        <mxCell id="e70" value="yes: complete result + assumptions" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c67"><mxGeometry relative="1" x="-0.5" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e71" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c67" target="c68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e72" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e73" value="claim unsupported (once)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c69" target="c68"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="2350"/><mxPoint x="620" y="2350"/></Array></mxGeometry></mxCell>
        <mxCell id="e74" value="SQL judged wrong: semantic_issue (same budget)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c69" target="c48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="2414"/><mxPoint x="1280" y="1513"/></Array></mxGeometry></mxCell>
        <mxCell id="c75" value="Markdown answer + chart spec + SQL + trace (per-agent timings)" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="2558" width="440" height="44" as="geometry"/></mxCell>
        <mxCell id="e76" value="answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c69" target="c75"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="2540"/><mxPoint x="620" y="2540"/></Array></mxGeometry></mxCell>
        <mxCell id="e77" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c78" value="STAGE 5 &amp;#8212; HUMAN REVIEW (v5.1)  (after the answer: a person's verdict, a reviewer's judgement)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2652" width="1160" height="520" as="geometry"/></mxCell>
        <mxCell id="c79" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Verdict&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;web or desktop client&lt;/font&gt;&lt;br&gt;- correct / wrong / correct but incomplete&lt;br&gt;- + an optional comment&lt;br&gt;- one per answer; a revote replaces it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c78"><mxGeometry x="40" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c80" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Staging database&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;feedbackdb&lt;/font&gt;&lt;br&gt;- a snapshot of the job: question, SQL,&lt;br&gt;- answer, result shape -- the job itself&lt;br&gt;- is forgotten within the hour" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c78"><mxGeometry x="420" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c81" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Review service&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;one pane per verdict&lt;/font&gt;&lt;br&gt;- a reviewer judges: accept or reject&lt;br&gt;- nothing reaches a store unreviewed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c78"><mxGeometry x="800" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="e82" value="a user judges the answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c75" target="c79"><mxGeometry relative="1" x="-0.35" as="geometry"><Array as="points"><mxPoint x="620" y="2628"/><mxPoint x="20" y="2628"/><mxPoint x="20" y="2744"/></Array></mxGeometry></mxCell>
        <mxCell id="e83" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c79" target="c80"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e84" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c80" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c85" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Golden pair&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;correct&lt;/font&gt;&lt;br&gt;- keywords, reasoning target, expected result&lt;br&gt;- previewed with the loader's own parser;&lt;br&gt;- promote is refused until it parses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c78"><mxGeometry x="40" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c86" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Corrected SQL&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;wrong&lt;/font&gt;&lt;br&gt;- the reviewer writes the query that should&lt;br&gt;- have been generated, starting from the&lt;br&gt;- agent's own" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c78"><mxGeometry x="420" y="180" width="320" height="84" as="geometry"/></mxCell>
