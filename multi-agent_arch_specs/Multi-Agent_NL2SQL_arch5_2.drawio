        <mxCell id="c25" value="Natural-language question" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="590" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="c26" value="STAGE 1 &amp;#8212; INTAKE AND CONTEXT GATHERING  (state: gathering; four retrievers run in parallel)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1160" height="484" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Supervisor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM&lt;/font&gt;&lt;br&gt;- in-domain? prompt-injected? ambiguous?&lt;br&gt;- intent: lookup / aggregate / compare / trend / narrative&lt;br&gt;- entities + measure + period -&amp;gt; answer contract&lt;br&gt;- one structured call; the only input screen&lt;br&gt;- model: light; standard when the pre-screen flags it (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c26"><mxGeometry x="410" y="50" width="340" height="124" as="geometry"/></mxCell>
        <mxCell id="c28" value="Refuse (out of domain, injected)&lt;br&gt;or ask to clarify (ambiguous; off in batch mode)" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="c26"><mxGeometry x="840" y="68" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="e29" value="verdict &amp;#8800; proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Schema Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- DDL-chunk vectors (ddl_index) top-6&lt;br&gt;- + tables named by knowledge and exemplars&lt;br&gt;- + foreign-key closure from pg_constraint&lt;br&gt;- cap 10 tables; no model call" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c26"><mxGeometry x="16" y="196" width="262" height="116" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Literal Matcher&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- literal catalog: text columns with&lt;br&gt;- &amp;lt;= 500 distinct values, trigram-indexed&lt;br&gt;- pg_trgm word_similarity (difflib fallback)&lt;br&gt;- phrase -&amp;gt; table.column = 'value'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c26"><mxGeometry x="308" y="196" width="262" height="116" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Knowledge Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question vector vs data dictionary&lt;br&gt;- and business index chunks&lt;br&gt;- top-4 per collection&lt;br&gt;- best-effort: skipped if the store is down" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c26"><mxGeometry x="600" y="196" width="262" height="116" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Example Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question 0.50 | BM25 keywords 0.35 |&lt;br&gt;- reasoning 0.15 -&amp;gt; score fusion&lt;br&gt;- -&amp;gt; grounding + MMR rerank -&amp;gt; top 3&lt;br&gt;- the v3 ensemble, unchanged" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c26"><mxGeometry x="892" y="196" width="262" height="116" as="geometry"/></mxCell>
