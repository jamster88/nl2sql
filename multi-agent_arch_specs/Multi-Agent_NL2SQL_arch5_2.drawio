        <mxCell id="c99" value="&lt;b&gt;Validate on the retail DB&lt;/b&gt;&lt;br&gt;reader role, READ ONLY, timeout,&lt;br&gt;row cap; run again on save" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c85"><mxGeometry x="420" y="310" width="320" height="80" as="geometry"/></mxCell>
