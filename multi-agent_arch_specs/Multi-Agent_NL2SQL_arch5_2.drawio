        <mxCell id="c14" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;calls the chat model (LLM)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="312" width="170" height="22" as="geometry"/></mxCell>
