        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Context Aggregator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;join, no LLM&lt;/font&gt;&lt;br&gt;- fan-in of the four branches; dedupe tables, apply FK closure and the cap&lt;br&gt;- fetch schema + sample rows; trim rules and exemplars to their budgets&lt;br&gt;- score the generator's rung from what it has seen (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c26"><mxGeometry x="330" y="362" width="500" height="94" as="geometry"/></mxCell>
        <mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c43" value="STAGE 2 &amp;#8212; SYNTHESIS  (state: compiling)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1184" width="1160" height="186" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;SQL Generator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM, multi-shot&lt;/font&gt;&lt;br&gt;- system: rules + dialect + pruned schema and sample rows&lt;br&gt;- turns: up to 3 exemplars replayed as human/assistant pairs (bare SQL answers)&lt;br&gt;- human: knowledge + literal map + intent framing + answer contract + question + repair hint (on retries)&lt;br&gt;- the only agent that writes SQL&lt;br&gt;- model: the rung the Aggregator scored, one rung up per repair; same prompt, num_ctx follows the model (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c43"><mxGeometry x="240" y="48" width="680" height="122" as="geometry"/></mxCell>
        <mxCell id="e45" value="pruned DDL + literal map + rules + exemplars" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c46" value="STAGE 3 &amp;#8212; VALIDATION AND REPAIR LOOP  (state: guarding; one counter, attempts, shared by every failure, including a result that ran but does not answer the question)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="1160" height="1132" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Static Validator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;pglast AST&lt;/font&gt;&lt;br&gt;- exactly one statement; SelectStmt only&lt;br&gt;- no writing CTE, no SELECT INTO, function denylist&lt;br&gt;- every relation in the table allowlist&lt;br&gt;- regex prefix check first, as a free pre-filter" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c46"><mxGeometry x="70" y="48" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c48" value="AST&lt;br&gt;passes?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c46"><mxGeometry x="200" y="180" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Planner Gate&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;EXPLAIN, never ANALYZE&lt;/font&gt;&lt;br&gt;- EXPLAIN (FORMAT JSON) in a READ ONLY txn&lt;br&gt;- surfaces unknown columns, casts, GROUP BY&lt;br&gt;- Plan.Total Cost &amp;lt;= MAX_PLAN_COST" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c46"><mxGeometry x="70" y="306" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c50" value="plan ok?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c46"><mxGeometry x="200" y="438" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Safe Executor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- reader role; SET TRANSACTION READ ONLY&lt;br&gt;- SET LOCAL statement_timeout; row cap&lt;br&gt;- SET ROLE principal for RLS, when present" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c46"><mxGeometry x="70" y="564" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c52" value="ran?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c46"><mxGeometry x="200" y="696" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completeness Reviewer&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rules, then one LLM reflection&lt;/font&gt;&lt;br&gt;- R1 a label beside every key (sku_id -&amp;gt; product_name)&lt;br&gt;- R2 a ranked list shows the measure it was ranked by&lt;br&gt;- R3 the period is stated; default = latest complete FY -&amp;gt; assumptions&lt;br&gt;- R4 the row count fits the ask (top 10 -&amp;gt; 10 rows)&lt;br&gt;- then one reflection: what would the reader ask next? schema columns only&lt;br&gt;- same-result guard: never sends one gap back twice&lt;br&gt;- reflection model: the generation's rung, capped at standard (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c46"><mxGeometry x="70" y="822" width="380" height="164" as="geometry"/></mxCell>
        <mxCell id="c54" value="answers the&lt;br&gt;question?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c46"><mxGeometry x="200" y="1020" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Repair Agent&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;classifier first; LLM only if unclassified&lt;/font&gt;&lt;br&gt;- error class -&amp;gt; hint (syntax position, nearest column,&lt;br&gt;- GROUP BY, cast, cost, timeout, audit, missing columns)&lt;br&gt;- appends {sql, issues} to attempt_history&lt;br&gt;- attempts += 1; never writes SQL itself&lt;br&gt;- diagnosis model: one rung above the generator's, standard at least (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c46"><mxGeometry x="690" y="306" width="430" height="132" as="geometry"/></mxCell>
        <mxCell id="c56" value="attempts&lt;br&gt;&amp;lt; max (7)?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c46"><mxGeometry x="825" y="494" width="160" height="96" as="geometry"/></mxCell>
        <mxCell id="c57" value="Give up: last SQL + full attempt history" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c46"><mxGeometry x="690" y="640" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="e58" value="raw SQL" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c47"><mxGeometry relative="1" x="-0.85" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e60" value="yes" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e62" value="yes" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e64" value="no: static issue" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e65" value="no: planner error / over budget" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e66" value="no: runtime error / timeout" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c55"><mxGeometry relative="1" x="-0.55" as="geometry"><Array as="points"><mxPoint x="670" y="2151"/><mxPoint x="670" y="1815"/></Array></mxGeometry></mxCell>
        <mxCell id="e67" value="yes: result set" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e68" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e69" value="no: incomplete (missing columns, wrong period or count)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" x="-0.6" as="geometry"><Array as="points"><mxPoint x="700" y="2475"/><mxPoint x="700" y="1835"/></Array></mxGeometry></mxCell>
        <mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e71" value="no" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e72" value="yes: regenerate with the hint, one rung up" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="1952"/><mxPoint x="1240" y="1293"/></Array></mxGeometry></mxCell>
        <mxCell id="c73" value="STAGE 4 &amp;#8212; PRESENTATION AND AUDIT  (state: formatting)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2582" width="1160" height="226" as="geometry"/></mxCell>
        <mxCell id="c74" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Visual Formatter&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- result shape -&amp;gt; scalar / bar / line / grouped bar / scatter / table&lt;br&gt;- intent breaks ties; emits ChartSpec + markdown table&lt;br&gt;- reads state; calls no upstream agent" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c73"><mxGeometry x="25" y="56" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="c75" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Insight Narrator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM&lt;/font&gt;&lt;br&gt;- structured claims: {text, value, cells, formula}&lt;br&gt;- sees the capped result set, the chart spec,&lt;br&gt;- the top exemplar's reasoning target, and the&lt;br&gt;- assumptions, each of which it must state&lt;br&gt;- model: light or standard by result size; audit retry one rung up (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c73"><mxGeometry x="405" y="56" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="c76" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Audit Checker&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- every claim value == a cell, or formula over cells&lt;br&gt;- every assumption stated (FY default, etc.)&lt;br&gt;- sensitive columns: aggregates only&lt;br&gt;- unsupported claim -&amp;gt; narrator once, then dropped" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c73"><mxGeometry x="785" y="56" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="e77" value="yes: complete result + assumptions" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c74"><mxGeometry relative="1" x="-0.5" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c74" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e79" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c75" target="c76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e80" value="claim unsupported (once)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c76" target="c75"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="2626"/><mxPoint x="620" y="2626"/></Array></mxGeometry></mxCell>
        <mxCell id="e81" value="SQL judged wrong: semantic_issue (same budget)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c76" target="c55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="2703"/><mxPoint x="1280" y="1782"/></Array></mxGeometry></mxCell>
        <mxCell id="c82" value="Markdown answer + chart spec + SQL + trace (per-agent timings)" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="2848" width="440" height="44" as="geometry"/></mxCell>
        <mxCell id="e83" value="answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c76" target="c82"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="2830"/><mxPoint x="620" y="2830"/></Array></mxGeometry></mxCell>
        <mxCell id="e84" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c85" value="STAGE 5 &amp;#8212; HUMAN REVIEW (v5.1)  (after the answer: a person's verdict, a reviewer's judgement)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2942" width="1160" height="520" as="geometry"/></mxCell>
        <mxCell id="c86" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Verdict&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;web or desktop client&lt;/font&gt;&lt;br&gt;- correct / wrong / correct but incomplete&lt;br&gt;- + an optional comment&lt;br&gt;- one per answer; a revote replaces it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c85"><mxGeometry x="40" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c87" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Staging database&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;feedbackdb&lt;/font&gt;&lt;br&gt;- a snapshot of the job: question, SQL,&lt;br&gt;- answer, result shape -- the job itself&lt;br&gt;- is forgotten within the hour" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c85"><mxGeometry x="420" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c88" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Review service&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;one pane per verdict&lt;/font&gt;&lt;br&gt;- a reviewer judges: accept or reject&lt;br&gt;- nothing reaches a store unreviewed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c85"><mxGeometry x="800" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="e89" value="a user judges the answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c82" target="c86"><mxGeometry relative="1" x="-0.35" as="geometry"><Array as="points"><mxPoint x="620" y="2918"/><mxPoint x="20" y="2918"/><mxPoint x="20" y="3034"/></Array></mxGeometry></mxCell>
        <mxCell id="e90" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c86" target="c87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e91" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c92" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Golden pair&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;correct&lt;/font&gt;&lt;br&gt;- keywords, reasoning target, expected result&lt;br&gt;- previewed with the loader's own parser;&lt;br&gt;- promote is refused until it parses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c85"><mxGeometry x="40" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c93" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Corrected SQL&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;wrong&lt;/font&gt;&lt;br&gt;- the reviewer writes the query that should&lt;br&gt;- have been generated, starting from the&lt;br&gt;- agent's own" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c85"><mxGeometry x="420" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c94" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completed SQL&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;correct but incomplete&lt;/font&gt;&lt;br&gt;- the query that would also have carried&lt;br&gt;- what the answer left out -- a name beside&lt;br&gt;- an id, the figure a ranking used" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c85"><mxGeometry x="800" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="e95" value="correct" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c88" target="c92"><mxGeometry relative="1" x="0.75" as="geometry"><Array as="points"><mxPoint x="1000" y="3100"/><mxPoint x="240" y="3100"/></Array></mxGeometry></mxCell>
