        <mxCell id="c16" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;join / fan-in&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="478" y="312" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;database gate / executor&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=center;verticalAlign=middle;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=14;spacingRight=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="662" y="312" width="190" height="22" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;stops the run&lt;/font&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="866" y="312" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c19" value="MODEL ROUTING (v5.2)  (not a stage: asked by every LLM agent, per call; calls no model; off = v5.1)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1160" height="194" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model catalog&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;models/catalog.json&lt;/font&gt;&lt;br&gt;- built by models/build_catalog.py, a script to be written:&lt;br&gt;- /api/tags -&amp;gt; /api/show per model -&amp;gt; the library page&lt;br&gt;- -&amp;gt; a prior per task and rung -&amp;gt; calibration probes&lt;br&gt;- suited[task] = highest rung measured within one question&lt;br&gt;- of the reference model; reviewed, committed, mounted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c19"><mxGeometry x="10" y="44" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model Router&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- route(task, rung) -&amp;gt; model, num_ctx, think, fallback, reason&lt;br&gt;- table built at startup: cheapest suited model per rung&lt;br&gt;- rung from state, by code: the Aggregator scores the generator&lt;br&gt;- (tables, bridge, intent, ranked, trap rule; near exemplar -2)&lt;br&gt;- routing off -&amp;gt; every rung is OLLAMA_MODEL (v5.1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c19"><mxGeometry x="400" y="44" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;The ladder&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;light -&gt; standard -&gt; heavy&lt;/font&gt;&lt;br&gt;- every repair climbs one rung; nothing descends within a run&lt;br&gt;- (a Tier 1 completeness gap retries once at the same rung)&lt;br&gt;- audit send-back: one rung up; diagnosis: above the generator&lt;br&gt;- at most three distinct models, kept warm on the host&lt;br&gt;- a routed model that fails -&amp;gt; its fallback -&amp;gt; OLLAMA_MODEL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c19"><mxGeometry x="790" y="44" width="360" height="134" as="geometry"/></mxCell>
