        <mxCell id="c19" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;calls the chat model (LLM)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="424" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;deterministic code&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="294" y="424" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;join / fan-in&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="478" y="424" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;database gate / executor&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=center;verticalAlign=middle;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=14;spacingRight=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="662" y="424" width="190" height="22" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;stops the run&lt;/font&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="866" y="424" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c24" value="MODEL ROUTING (v5.2, built 5.2.0)  (not a stage: asked by every LLM agent, per call; calls no model; off = v5.1)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="468" width="1160" height="194" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model catalog&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;models/catalog.json&lt;/font&gt;&lt;br&gt;- built by models/build_catalog.py, measured by calibrate.py:&lt;br&gt;- /api/tags -&amp;gt; /api/show per model -&amp;gt; the library page&lt;br&gt;- -&amp;gt; a prior per task and rung -&amp;gt; calibration probes&lt;br&gt;- suited[task] = highest rung measured within one question&lt;br&gt;- of the reference model; reviewed, committed, mounted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c24"><mxGeometry x="10" y="44" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model Router&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- route(task, rung) -&amp;gt; model, num_ctx, think, fallback, reason&lt;br&gt;- table built at startup: cheapest suited model per rung&lt;br&gt;- rung from state, by code: the Aggregator scores the generator&lt;br&gt;- (tables, bridge, intent, ranked, trap rule; near exemplar -2)&lt;br&gt;- routing off -&amp;gt; every rung is OLLAMA_MODEL (v5.1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c24"><mxGeometry x="400" y="44" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;The ladder&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;light -&gt; standard -&gt; heavy&lt;/font&gt;&lt;br&gt;- every repair climbs one rung; nothing descends within a run&lt;br&gt;- (a Tier 1 completeness gap retries once at the same rung)&lt;br&gt;- audit send-back: one rung up; diagnosis: above the generator&lt;br&gt;- at most three distinct models, kept warm on the host&lt;br&gt;- a routed model that fails -&amp;gt; its fallback -&amp;gt; OLLAMA_MODEL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c24"><mxGeometry x="790" y="44" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" value="WHO IS ASKING (v6.0; section 20)  (not a stage: every page, the API, the console and MLflow need a person; off = --no-auth)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="686" width="1160" height="176" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Sign-in&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the auth service&lt;/font&gt;&lt;br&gt;- connects to the retail DB as the person:&lt;br&gt;- pg_hba ldap binds to the directory&lt;br&gt;- hostssl, verify-full, StartTLS (6.1)&lt;br&gt;- throttle 5/name, 50/address; lockout" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c30"><mxGeometry x="25" y="44" width="264" height="116" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Session&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;Ed25519, 8 h&lt;/font&gt;&lt;br&gt;- verified by every service with the&lt;br&gt;- public half; header compared whole&lt;br&gt;- groups re-read from Postgres &amp;lt;= 60 s&lt;br&gt;- cookie HttpOnly, SameSite=Strict, Secure" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c30"><mxGeometry x="307" y="44" width="264" height="116" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Runs as the person&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;SET LOCAL ROLE&lt;/font&gt;&lt;br&gt;- the reader becomes them per question:&lt;br&gt;- SET TRUE, INHERIT FALSE&lt;br&gt;- attribution, not yet isolation:&lt;br&gt;- no row-level policies" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c30"><mxGeometry x="589" y="44" width="264" height="116" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;TLS identities&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the stack's CA (6.1)&lt;/font&gt;&lt;br&gt;- a key per server, in its own volume&lt;br&gt;- proxies verify upstreams by name&lt;br&gt;- browsers and the desktop trust&lt;br&gt;- ca.crt once; the CA key is pki's" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c30"><mxGeometry x="871" y="44" width="264" height="116" as="geometry"/></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="Natural-language question" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="902" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="c38" value="STAGE 1 &amp;#8212; INTAKE AND CONTEXT GATHERING  (state: gathering; five retrievers run in parallel)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="972" width="1160" height="484" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Supervisor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM&lt;/font&gt;&lt;br&gt;- in-domain? prompt-injected? ambiguous?&lt;br&gt;- intent: lookup / aggregate / compare / trend / narrative&lt;br&gt;- entities + measure + period -&amp;gt; answer contract&lt;br&gt;- one structured call; the only input screen&lt;br&gt;- model: light; standard when the pre-screen flags it (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c38"><mxGeometry x="410" y="50" width="340" height="124" as="geometry"/></mxCell>
        <mxCell id="c40" value="Refuse (out of domain, injected)&lt;br&gt;or ask to clarify (ambiguous; off in batch mode)" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="c38"><mxGeometry x="840" y="68" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="e41" value="verdict &amp;#8800; proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c42" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Schema Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- DDL-chunk vectors (ddl_index) top-6&lt;br&gt;- + tables named by knowledge and exemplars&lt;br&gt;- + foreign-key closure from pg_constraint&lt;br&gt;- cap 10 tables; no model call" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c38"><mxGeometry x="16" y="196" width="208" height="140" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Literal Matcher&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- literal catalog: text columns with&lt;br&gt;- &amp;lt;= 500 distinct values, trigram-indexed&lt;br&gt;- pg_trgm word_similarity (difflib fallback)&lt;br&gt;- phrase -&amp;gt; table.column = 'value'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c38"><mxGeometry x="245" y="196" width="208" height="140" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Knowledge Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question vector vs data dictionary&lt;br&gt;- and business index chunks&lt;br&gt;- top-4 per collection&lt;br&gt;- best-effort: skipped if the store is down" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c38"><mxGeometry x="474" y="196" width="208" height="140" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Example Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- question 0.50 | BM25 keywords 0.35 |&lt;br&gt;- reasoning 0.15 -&amp;gt; score fusion&lt;br&gt;- -&amp;gt; grounding + MMR rerank -&amp;gt; top 3&lt;br&gt;- the v3 ensemble, unchanged" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c38"><mxGeometry x="703" y="196" width="208" height="140" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Snippet Retriever&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- verified SQL pieces (v5.6): joins,&lt;br&gt;- filters, measures, dimensions&lt;br&gt;- keyword + meaning; no model call&lt;br&gt;- only in-scope ones reach the generator" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c38"><mxGeometry x="932" y="196" width="208" height="140" as="geometry"/></mxCell>
        <mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c52" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Context Aggregator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;join, no LLM&lt;/font&gt;&lt;br&gt;- fan-in of the five branches; dedupe tables, apply FK closure and the cap&lt;br&gt;- fetch schema + sample rows; trim rules and exemplars to their budgets&lt;br&gt;- score the generator's rung from what it has seen (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c38"><mxGeometry x="330" y="362" width="500" height="94" as="geometry"/></mxCell>
        <mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e57" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c58" value="STAGE 2 &amp;#8212; SYNTHESIS  (state: compiling)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1496" width="1160" height="186" as="geometry"/></mxCell>
        <mxCell id="c59" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;SQL Generator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM, multi-shot&lt;/font&gt;&lt;br&gt;- system: rules + dialect + pruned schema and sample rows&lt;br&gt;- turns: up to 3 exemplars replayed as human/assistant pairs (bare SQL answers)&lt;br&gt;- human: knowledge + literal map + intent framing + answer contract + question + repair hint (on retries)&lt;br&gt;- the only agent that writes SQL&lt;br&gt;- model: the rung the Aggregator scored, one rung up per repair; same prompt, num_ctx follows the model (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c58"><mxGeometry x="240" y="48" width="680" height="122" as="geometry"/></mxCell>
        <mxCell id="e60" value="pruned DDL + literal map + rules + exemplars" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c61" value="STAGE 3 &amp;#8212; VALIDATION AND REPAIR LOOP  (state: guarding; one counter, attempts, shared by every failure, including a result that ran but does not answer the question)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1722" width="1160" height="1132" as="geometry"/></mxCell>
        <mxCell id="c62" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Static Validator&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;pglast AST&lt;/font&gt;&lt;br&gt;- exactly one statement; SelectStmt only&lt;br&gt;- no writing CTE, no SELECT INTO, function denylist&lt;br&gt;- every relation in the table allowlist&lt;br&gt;- regex prefix check first, as a free pre-filter" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c61"><mxGeometry x="70" y="48" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c63" value="AST&lt;br&gt;passes?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c61"><mxGeometry x="200" y="180" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Planner Gate&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;EXPLAIN, never ANALYZE&lt;/font&gt;&lt;br&gt;- EXPLAIN (FORMAT JSON) in a READ ONLY txn&lt;br&gt;- surfaces unknown columns, casts, GROUP BY&lt;br&gt;- Plan.Total Cost &amp;lt;= MAX_PLAN_COST" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c61"><mxGeometry x="70" y="306" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c65" value="plan ok?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c61"><mxGeometry x="200" y="438" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Safe Executor&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- reader role; SET TRANSACTION READ ONLY&lt;br&gt;- SET LOCAL statement_timeout; row cap&lt;br&gt;- SET ROLE principal for RLS, when present" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c61"><mxGeometry x="70" y="564" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c67" value="ran?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c61"><mxGeometry x="200" y="696" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completeness Reviewer&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rules, then one LLM reflection&lt;/font&gt;&lt;br&gt;- R1 a label beside every key (sku_id -&amp;gt; product_name)&lt;br&gt;- R2 a ranked list shows the measure it was ranked by&lt;br&gt;- R3 the period is stated; default = latest complete FY -&amp;gt; assumptions&lt;br&gt;- R4 the row count fits the ask (top 10 -&amp;gt; 10 rows)&lt;br&gt;- then one reflection: what would the reader ask next? schema columns only&lt;br&gt;- same-result guard: never sends one gap back twice&lt;br&gt;- reflection model: the generation's rung, capped at standard (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c61"><mxGeometry x="70" y="822" width="380" height="164" as="geometry"/></mxCell>
        <mxCell id="c69" value="answers the&lt;br&gt;question?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c61"><mxGeometry x="200" y="1020" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Repair Agent&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;classifier first; LLM only if unclassified&lt;/font&gt;&lt;br&gt;- error class -&amp;gt; hint (syntax position, nearest column,&lt;br&gt;- GROUP BY, cast, cost, timeout, audit, missing columns)&lt;br&gt;- appends {sql, issues} to attempt_history&lt;br&gt;- attempts += 1; never writes SQL itself&lt;br&gt;- empties the attempt's fields: rows, chart, claims, audit (v6.1)&lt;br&gt;- diagnosis model: one rung above the generator's, standard at least (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c61"><mxGeometry x="690" y="306" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="c71" value="attempts&lt;br&gt;&amp;lt; max (7)?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c61"><mxGeometry x="825" y="494" width="160" height="96" as="geometry"/></mxCell>
        <mxCell id="c72" value="Give up: last SQL + full attempt history" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c61"><mxGeometry x="690" y="640" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="e73" value="raw SQL" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c62"><mxGeometry relative="1" x="-0.85" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e74" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e75" value="yes" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
