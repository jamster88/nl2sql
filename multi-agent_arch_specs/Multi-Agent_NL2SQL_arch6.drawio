        <mxCell id="c100" value="STAGE 5 &amp;#8212; HUMAN REVIEW (v5.1; undo 5.4; curation 5.6)  (after the answer: a person's verdict, a reviewer's judgement)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="3254" width="1160" height="520" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Verdict&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;web or desktop client&lt;/font&gt;&lt;br&gt;- correct / wrong / correct but incomplete&lt;br&gt;- + an optional comment&lt;br&gt;- one per answer; a revote replaces it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c100"><mxGeometry x="40" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Staging database&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;feedbackdb&lt;/font&gt;&lt;br&gt;- a snapshot of the job: question, SQL,&lt;br&gt;- answer, result shape -- the job itself&lt;br&gt;- is forgotten within the hour" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c100"><mxGeometry x="420" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Review service&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;one pane per verdict&lt;/font&gt;&lt;br&gt;- a reviewer judges: accept or reject&lt;br&gt;- back to pending or delete undoes it (5.4)&lt;br&gt;- the curation page writes directly (5.6)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c100"><mxGeometry x="800" y="50" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="e104" value="a user judges the answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c97" target="c101"><mxGeometry relative="1" x="-0.35" as="geometry"><Array as="points"><mxPoint x="620" y="3230"/><mxPoint x="20" y="3230"/><mxPoint x="20" y="3346"/></Array></mxGeometry></mxCell>
        <mxCell id="e105" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c101" target="c102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e106" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c102" target="c103"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c107" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Golden pair&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;correct&lt;/font&gt;&lt;br&gt;- keywords, reasoning target, expected result&lt;br&gt;- previewed with the loader's own parser;&lt;br&gt;- promote is refused until it parses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c100"><mxGeometry x="40" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c108" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Corrected SQL&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;wrong&lt;/font&gt;&lt;br&gt;- the reviewer writes the query that should&lt;br&gt;- have been generated, starting from the&lt;br&gt;- agent's own" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c100"><mxGeometry x="420" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c109" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completed SQL&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;correct but incomplete&lt;/font&gt;&lt;br&gt;- the query that would also have carried&lt;br&gt;- what the answer left out -- a name beside&lt;br&gt;- an id, the figure a ranking used" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c100"><mxGeometry x="800" y="180" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="e110" value="correct" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c103" target="c107"><mxGeometry relative="1" x="0.75" as="geometry"><Array as="points"><mxPoint x="1000" y="3412"/><mxPoint x="240" y="3412"/></Array></mxGeometry></mxCell>
        <mxCell id="e111" value="wrong" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c103" target="c108"><mxGeometry relative="1" x="0.7" as="geometry"><Array as="points"><mxPoint x="1000" y="3412"/><mxPoint x="620" y="3412"/></Array></mxGeometry></mxCell>
        <mxCell id="e112" value="correct but incomplete" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c103" target="c109"><mxGeometry relative="1" x="0.2" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c113" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Golden set&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the benchmark&lt;/font&gt;&lt;br&gt;- context_questions/translated_questions.md,&lt;br&gt;- written in the checkout and committed&lt;br&gt;- reloaded into chunkdb + vectordb&lt;br&gt;- what the agent is measured against --&lt;br&gt;- so no fix ever goes here" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c100"><mxGeometry x="40" y="330" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="c114" value="&lt;b&gt;Validate on the retail DB&lt;/b&gt;&lt;br&gt;reader role, READ ONLY, timeout,&lt;br&gt;row cap; run again on save" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c100"><mxGeometry x="420" y="310" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="c115" value="&lt;b&gt;Validate on the retail DB&lt;/b&gt;&lt;br&gt;reader role, READ ONLY, timeout,&lt;br&gt;row cap; run again on save" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;align=left;verticalAlign=top;spacingLeft=23;spacingRight=23;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c100"><mxGeometry x="800" y="310" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="c116" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Corrections store&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;records + RAG&lt;/font&gt;&lt;br&gt;- question, incorrect answer, correct answer&lt;br&gt;- a bge-m3 vector of each question beside&lt;br&gt;- both queries, for a later agent to retrieve" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c100"><mxGeometry x="420" y="420" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c117" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Completions store&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;records + RAG&lt;/font&gt;&lt;br&gt;- question, incomplete answer, complete one&lt;br&gt;- its own database and RAG, apart from&lt;br&gt;- the corrections and the golden set" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c100"><mxGeometry x="800" y="420" width="320" height="84" as="geometry"/></mxCell>
