<mxfile host="Electron" agent="arch7.2 generator" version="31.4.5">
  <diagram name="Multi-Agent NL2SQL v7.2" id="arch7_2-v7_2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="2656" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Multi-Agent NL2SQL, v7.2&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#666666&quot;&gt; &amp;#8212; the question asked several ways: arch6 run once per wording, one after another by default (the host serves one call at a time; a deployer may allow more); the results checked and grouped, every distinct answer read by the Judge before the vote, the accepted voted on, one chosen or fused; arch7.1 with its Phase 3 as built and a grain check of its own (Phase 6), 2026-10-09; supersedes arch7.1, arch7 and arch6.3 where they disagree&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1160" height="44" as="geometry"/></mxCell>
        <mxCell id="c2" value="LEGEND" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;fontStyle=1;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="60" height="22" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;calls the chat model (LLM)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;deterministic code&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="294" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;join / fan-out plan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="478" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;the arch6 pipeline, one run&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="662" y="62" width="190" height="22" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;stops the run&lt;/font&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="866" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c8" value="MODEL ROUTING (v5.2)  (not a stage: asked by every LLM agent, per call; arch7 adds two tasks and bumps the catalog to schema 3)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="1160" height="206" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model catalog&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;models/catalog.json, schema 3&lt;/font&gt;&lt;br&gt;- seven tasks: supervisor, generator, reflection,&lt;br&gt;- narrator, repair + paraphraser, judge (v7)&lt;br&gt;- two probes more: fidelity of rewordings against&lt;br&gt;- the reference's reading; verdicts that match the reference&lt;br&gt;- a schema-2 catalog loads with the two unmeasured" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c8"><mxGeometry x="10" y="44" width="360" height="146" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model Router&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- route(task, rung) -&amp;gt; model, num_ctx, think, fallback, reason&lt;br&gt;- paraphraser: light; standard when the pre-screen flags&lt;br&gt;- judge: heavy, always -- once a wave, decides which answers count&lt;br&gt;- unmeasured task -&amp;gt; OLLAMA_MODEL (routes on measured only)&lt;br&gt;- every call to the host takes a slot: OLLAMA_PARALLEL_CALLS (1 = serial, default)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c8"><mxGeometry x="400" y="44" width="360" height="146" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;The ladder&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;light -&gt; standard -&gt; heavy&lt;/font&gt;&lt;br&gt;- inside each candidate run, as arch6: every repair climbs&lt;br&gt;- each candidate's generator is scored by its own aggregator&lt;br&gt;- so two wordings may run at two rungs (their diversity)&lt;br&gt;- MODEL_ROUTE_PARAPHRASER, MODEL_ROUTE_JUDGE pin a rung&lt;br&gt;- a routed model that fails -&amp;gt; its fallback -&amp;gt; OLLAMA_MODEL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c8"><mxGeometry x="790" y="44" width="360" height="146" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="Natural-language question" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="352" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="c15" value="STAGE 0 &amp;#8212; ASKING IT SEVERAL WAYS  (arch7.2, section 22.3: the anchor, the rewordings, the fidelity gate, the wave)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="1160" height="560" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;screen&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the Supervisor on the original, LLM&lt;/font&gt;&lt;br&gt;- the anchor: verdict, intent, the answer contract&lt;br&gt;- every rewording is held to this contract&lt;br&gt;- nothing is reworded before this call: an injection rephrased&lt;br&gt;- is still an attempt, further from the words the screen saw&lt;br&gt;- model: light; standard when the pre-screen flags (v5.2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c15"><mxGeometry x="380" y="50" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="c17" value="Refuse (out of domain, injected)&lt;br&gt;or ask to clarify (ambiguous)&lt;br&gt;&amp;#8212; nothing is reworded" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="c15"><mxGeometry x="840" y="68" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e18" value="verdict &amp;#8800; proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;paraphrase&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the Paraphraser, LLM, one structured call&lt;/font&gt;&lt;br&gt;- the question and what may not change, in plain words; no rows or column names&lt;br&gt;- keeps every number, year, name, quoted value, the entities, the measure,&lt;br&gt;- the period, the direction and the row count; varies words and sentence shape&lt;br&gt;- writes up to ENSEMBLE_MAX_PARAPHRASES (10), most different first, each with 'what changed'&lt;br&gt;- asked once more for replacements if too few pass the gate; never a third time" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c15"><mxGeometry x="330" y="190" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="e20" value="proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F1 numbers&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- the multiset of numerals equals&lt;br&gt;- the original's; number words&lt;br&gt;- one to twenty count as numerals&lt;br&gt;- 'top ten' -&amp;gt; 'top five' fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="16" y="330" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F2 literals&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- every quoted string and every&lt;br&gt;- capitalised multi-word phrase&lt;br&gt;- appears verbatim (case-insensitive)&lt;br&gt;- 'Dairy &amp;amp; Eggs' -&amp;gt; 'dairy' fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="245" y="330" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F3 polarity&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- the direction classes present are&lt;br&gt;- equal: superlative high / low,&lt;br&gt;- change up / down, negation&lt;br&gt;- 'lowest' -&amp;gt; 'highest' fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="474" y="330" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F4 the same contract&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- the Supervisor reads the rewording;&lt;br&gt;- its contract, in the original's shape,&lt;br&gt;- must equal the anchor's: entities,&lt;br&gt;- measure, period; proceed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c15"><mxGeometry x="703" y="330" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F5 distinct&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- differs from the original and from&lt;br&gt;- each one before it that passed;&lt;br&gt;- token Jaccard &amp;lt;= 0.8 to each&lt;br&gt;- two that differ by a comma: one kept" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c15"><mxGeometry x="932" y="330" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c31" value="screen_paraphrase &amp;#8212; one rewording after another by default (OLLAMA_PARALLEL_CALLS=1); a rewording that fails any check is discarded with the check's name and never run" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="c15"><mxGeometry x="16" y="308" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;plan_wave&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;join, no LLM&lt;/font&gt;&lt;br&gt;- wave 1: the original + the first ENSEMBLE_PARAPHRASES (3) faithful rewordings -&amp;gt; 4 runs&lt;br&gt;- wave 2: the rest, up to 10 in all -- only when the vote is unsettled, while waves &amp;lt; ENSEMBLE_WAVES (2)&lt;br&gt;- and, when a deadline is set (ENSEMBLE_DEADLINE_SECONDS; none by default), before it; a wave in flight is always awaited" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c15"><mxGeometry x="310" y="470" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="THE CANDIDATE RUNS &amp;#8212; answer: the arch6 pipeline once per wording, one after another by default  (section 22.4; OLLAMA_PARALLEL_CALLS, 1 unless the deployer's host serves more)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1022" width="1160" height="400" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 0&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the original&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c38"><mxGeometry x="16" y="50" width="208" height="262" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 1&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rewording 1&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c38"><mxGeometry x="245" y="50" width="208" height="262" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 2&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rewording 2&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c38"><mxGeometry x="474" y="50" width="208" height="262" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 3&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rewording 3&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c38"><mxGeometry x="703" y="50" width="208" height="262" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidates 4..10&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;a second wave, on disagreement&lt;/font&gt;&lt;br&gt;- up to seven more rewordings, the&lt;br&gt;- next most different first,&lt;br&gt;- each the same whole pipeline&lt;br&gt;- run only when wave 1's vote is&lt;br&gt;- unsettled (no majority, or one run),&lt;br&gt;- a wave is left and time is left&lt;br&gt;- the Judge then reads every group&lt;br&gt;- again, and the vote is recomputed&lt;br&gt;- over every candidate" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontColor=#666666;" vertex="1" parent="c38"><mxGeometry x="932" y="50" width="208" height="262" as="geometry"/></mxCell>
        <mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e48" value="wave 2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;dashed=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c43"><mxGeometry relative="1" x="0.3" as="geometry"><Array as="points"><mxPoint x="836" y="1062"/><mxPoint x="1076" y="1062"/></Array></mxGeometry></mxCell>
        <mxCell id="c49" value="Each run keeps its whole state: sql, rows, completeness, audit, attempt history and trace. Progress events and trace spans carry the candidate's index [k]; MLflow shows one trace per question with a run per wording inside it." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="c38"><mxGeometry x="16" y="330" width="1128" height="18" as="geometry"/></mxCell>
        <mxCell id="c50" value="* grain: the grain check (Phase 6, section 22.14) -- a join of tables of different grains on their dates, the finer not rolled up first, is a validation failure sent to the Repair Agent." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="c38"><mxGeometry x="16" y="352" width="1128" height="18" as="geometry"/></mxCell>
        <mxCell id="c51" value="STAGE 6 &amp;#8212; VALIDATION, THE JUDGE, THE VOTE AND FUSION  (sections 22.5-22.8: the groups in code; the Judge on every question, before the vote; the vote in code, over the accepted)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1462" width="1160" height="910" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;validate, tier 1: admissibility&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM, per candidate&lt;/font&gt;&lt;br&gt;- E1 answered: proceed, no error (a give-up does not vote)&lt;br&gt;- E2 faithful: its wording passed the gate (the original trivially)&lt;br&gt;- E3 complete enough: the anchor contract's R1-R4 find no fatal gap -- rows at all&lt;br&gt;- E4 audited: no semantic_issue outstanding (the audit found the rows right)&lt;br&gt;- E5 comparable: not truncated, unless the question is ranked&lt;br&gt;- a gap or a dropped claim ranks a candidate lower; only the fatal cases exclude it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c51"><mxGeometry x="70" y="50" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;validate, tier 2: agreement&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM, every pair&lt;/font&gt;&lt;br&gt;- result_matches(a, b, ordered) or (b, a): the benchmark's own scorer --&lt;br&gt;- columns as presentation, extra columns allowed, rows the same under some&lt;br&gt;- reading of the columns, numbers within 1e-6 or at two decimals&lt;br&gt;- groups = connected components (union-find), largest first, ties to the original's&lt;br&gt;- signature per group: a scalar's value, or row count + first row's labels and measure" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c51"><mxGeometry x="70" y="230" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;judge&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM, every question, before the vote&lt;/font&gt;&lt;br&gt;- the question, what every answer was held to, the knowledge the original's run had,&lt;br&gt;- and per group, by letter, the original's first: its SQL, columns, first five rows --&lt;br&gt;- never how many runs gave it&lt;br&gt;- -&amp;gt; a verdict per letter: accepted, or set aside with the mistake in its query named&lt;br&gt;- a letter that names no answer is ignored; an answer with no verdict stands&lt;br&gt;- cannot write SQL, call an agent or start a run (W3); once a wave&lt;br&gt;- model: heavy, always; if it fails, the runs vote alone" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c51"><mxGeometry x="70" y="400" width="500" height="160" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;vote&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM, the accepted only&lt;/font&gt;&lt;br&gt;- A = the admissible less those set aside; g = the largest accepted group&lt;br&gt;- unanimous (g = A), majority (g &amp;gt; A/2 and g &amp;gt;= 2), single (A = 1)&lt;br&gt;- judged: the winner is not the runs' own choice -- the Judge set that aside&lt;br&gt;- accepted none: the runs' own choice, 'contested', with the Judge's objection&lt;br&gt;- none admissible: none -- the original's give-up is delivered&lt;br&gt;- the Judge off, or nothing to judge: the runs vote alone" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c51"><mxGeometry x="70" y="590" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c56" value="no majority:&lt;br&gt;a wave left,&lt;br&gt;time left?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c51"><mxGeometry x="250" y="778" width="140" height="104" as="geometry"/></mxCell>
        <mxCell id="c57" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;fuse&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- select the representative: complete &amp;gt; audited &amp;gt; the original &amp;gt;&lt;br&gt;- fewer attempts &amp;gt; cheaper plan &amp;gt; lower index; its SQL, rows, chart&lt;br&gt;- no SQL is ever fused (the generator is the only place SQL is written)&lt;br&gt;- columns other members carried, joined on the entity's key when every&lt;br&gt;- row matches once (ENSEMBLE_FUSE_COLUMNS: a toggle, on by default)&lt;br&gt;- claims: the others' about rows not yet spoken of, checked cell by cell,&lt;br&gt;- re-audited; at most ENSEMBLE_MAX_CLAIMS (8); assumptions once&lt;br&gt;- dissent: each loser's key fact + its tables, filters, roll-ups and joins" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c51"><mxGeometry x="650" y="400" width="450" height="204" as="geometry"/></mxCell>
        <mxCell id="c58" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;deliver&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- render_answer for the original question: the fused claims, the table,&lt;br&gt;- the agreement line first ('agreed by 4 of 4 runs'; what the Judge set aside),&lt;br&gt;- the dissent among the notes; folded beneath: every candidate's wording, what&lt;br&gt;- it changed, outcome, SQL, key fact, the Judge's verdict on it; the discarded&lt;br&gt;- rewordings with the check that discarded them" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c51"><mxGeometry x="650" y="772" width="450" height="118" as="geometry"/></mxCell>
        <mxCell id="e59" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e60" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e62" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e64" value="the admissible" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e65" value="the groups" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e66" value="Judge off" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="65" y="1776"/><mxPoint x="65" y="2097"/></Array></mxGeometry></mxCell>
        <mxCell id="e67" value="a verdict per group" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e68" value="a winner" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c57"><mxGeometry relative="1" x="-0.3" as="geometry"><Array as="points"><mxPoint x="640" y="2112"/><mxPoint x="640" y="1944"/></Array></mxGeometry></mxCell>
        <mxCell id="e69" value="unsettled: no majority among the accepted, or one run" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e70" value="no: 'contested'" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" x="-0.55" as="geometry"><Array as="points"><mxPoint x="665" y="2292"/><mxPoint x="665" y="2025"/></Array></mxGeometry></mxCell>
        <mxCell id="e71" value="yes: a second wave, then validate, judge and vote again (one counter: waves)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c32"><mxGeometry relative="1" x="-0.45" as="geometry"><Array as="points"><mxPoint x="20" y="2292"/><mxPoint x="20" y="931"/></Array></mxGeometry></mxCell>
        <mxCell id="e72" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e73" value="none admissible" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c58"><mxGeometry relative="1" x="-0.75" as="geometry"><Array as="points"><mxPoint x="680" y="2187"/><mxPoint x="680" y="2269"/></Array></mxGeometry></mxCell>
        <mxCell id="c74" value="Answer: the chosen rows, widened with columns other agreeing runs carried, and SQL + the fused, re-audited claims + 'k of n' + every candidate's record (REST: Answer.ensemble)" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="2412" width="600" height="44" as="geometry"/></mxCell>
        <mxCell id="e75" value="answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c58" target="c74"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="2394"/><mxPoint x="620" y="2394"/></Array></mxGeometry></mxCell>
        <mxCell id="c76" value="STAGE 5 &amp;#8212; HUMAN REVIEW (v5.1-5.6; unchanged by arch7.2)  (the verdict is on the delivered answer)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2496" width="1160" height="120" as="geometry"/></mxCell>
        <mxCell id="c77" value="- the three verdicts, the staging database, the review and curation pages: as arch6 section 14&lt;br&gt;- the snapshot gains the ensemble record, so a reviewer fixing a wrong answer sees the dissent and the other queries that agreed&lt;br&gt;- promotion into the golden set uses the original wording and the chosen SQL: a golden pair records what a person asked, in their words" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c76"><mxGeometry x="20" y="44" width="1120" height="60" as="geometry"/></mxCell>
