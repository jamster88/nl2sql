<mxfile host="Electron" agent="arch8 generator" version="31.4.5">
  <diagram name="Multi-Agent NL2SQL v8" id="arch8-v8">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="2992" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Multi-Agent NL2SQL, v8&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#666666&quot;&gt; &amp;#8212; arch7.3 as 7.0.0 published it, with the conversation remembered: the last CONVERSATION_MEMORY answered turns (5 by default, 15 at most, 0 none) read by the Supervisor, which restates a follow-up so that it stands alone, and shown to the SQL Generator as the earlier questions of this conversation with their SQL; and the pipeline chosen by release name at start (PIPELINE_VERSION: v7_0_0 the ensemble, v6_3_1 one run a question), said in every record; 2026-10-14, a design; supersedes arch7.3 where they disagree&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1160" height="44" as="geometry"/></mxCell>
        <mxCell id="c2" value="LEGEND" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;fontStyle=1;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="60" height="22" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;calls the chat model (LLM)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;deterministic code&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="294" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;join / fan-out plan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="478" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;the arch6 pipeline, one run&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="1"><mxGeometry x="662" y="62" width="190" height="22" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;the conversation (v8)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="866" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;stops the run&lt;/font&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="62" width="170" height="22" as="geometry"/></mxCell>
        <mxCell id="c9" value="MODEL ROUTING (v5.2)  (not a stage: asked by every LLM agent, per call; arch7 adds two tasks and bumps the catalog to schema 3; v8: PIPELINE_VERSION names which pipeline answers, read once at start and said in every record)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="1160" height="222" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model catalog&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;models/catalog.json, schema 3&lt;/font&gt;&lt;br&gt;- seven tasks: supervisor, generator, reflection,&lt;br&gt;- narrator, repair + paraphraser, judge (v7)&lt;br&gt;- two probes more: fidelity of rewordings against&lt;br&gt;- the reference's reading; verdicts that match the reference&lt;br&gt;- a schema-2 catalog loads with the two unmeasured" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="c9"><mxGeometry x="10" y="44" width="360" height="162" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Model Router&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- route(task, rung) -&amp;gt; model, num_ctx, think, fallback, reason&lt;br&gt;- supervisor: standard whenever turns are shown (v8); else as before&lt;br&gt;- paraphraser: light; standard when the pre-screen flags&lt;br&gt;- judge: heavy, always -- once a wave, decides which answers count&lt;br&gt;- unmeasured task -&amp;gt; OLLAMA_MODEL (routes on measured only)&lt;br&gt;- every call to the host takes a slot: OLLAMA_PARALLEL_CALLS (1 = serial, default)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c9"><mxGeometry x="400" y="44" width="360" height="162" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;The ladder&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;light -&gt; standard -&gt; heavy&lt;/font&gt;&lt;br&gt;- inside each candidate run, as arch6: every repair climbs&lt;br&gt;- each candidate's generator is scored by its own aggregator&lt;br&gt;- PIPELINE_VERSION=v6_3_1: one run, no Stage 0 or 6 (v8)&lt;br&gt;- MODEL_ROUTE_PARAPHRASER, MODEL_ROUTE_JUDGE pin a rung&lt;br&gt;- a routed model that fails -&amp;gt; its fallback -&amp;gt; OLLAMA_MODEL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c9"><mxGeometry x="790" y="44" width="360" height="162" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="Natural-language question, as typed" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="368" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="c16" value="THE CONVERSATION (v8, section 23)  (in the memory of the process that serves it -- the REST API, or one CLI session -- never on disk; the agent is stateless and is handed the turns with the question)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="1160" height="222" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;conversation store&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;api/conversations.py; no LLM&lt;/font&gt;&lt;br&gt;- keyed by the person who asked and a client-chosen id&lt;br&gt;- (1..64 of [A-Za-z0-9._-]); another person's same id is another&lt;br&gt;- the last CONVERSATION_MEMORY answered turns (5; 0..15; 0 is off)&lt;br&gt;- at most API_MAX_CONVERSATIONS (200), least recently used first&lt;br&gt;- forgotten after API_CONVERSATION_TTL_SECONDS (3600) of silence,&lt;br&gt;- on DELETE /v1/conversations/{id}, and on restart&lt;br&gt;- one question at a time a conversation: a second is 409" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c16"><mxGeometry x="10" y="44" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;a turn&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;memory.Turn; answered questions only&lt;/font&gt;&lt;br&gt;- asked: the words typed; question: the standalone reading&lt;br&gt;- sql: the delivered query (the chosen candidate's)&lt;br&gt;- columns, the first MEMORY_ROWS (3) rows, row_count&lt;br&gt;- answer: the narrative's first sentence (300 chars); assumptions&lt;br&gt;- a refusal, a clarification, a give-up: no turn&lt;br&gt;- a turn whose answer the person marked wrong: forgotten at once&lt;br&gt;- a turn is history, never instructions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c16"><mxGeometry x="400" y="44" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;the two readers&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;and nothing else reads a turn&lt;/font&gt;&lt;br&gt;- the Supervisor (screen / supervise): the turns, oldest first --&lt;br&gt;- question, answer sentence, rows, assumptions -- and restates&lt;br&gt;- a follow-up so that it stands alone; C1-C4 in code hold it&lt;br&gt;- to the words typed; then question := the standalone&lt;br&gt;- the SQL Generator: the turns' questions and SQL, as turns&lt;br&gt;- after the exemplars, nearest the question&lt;br&gt;- PIPELINE_VERSION: the same two readers under either name" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c16"><mxGeometry x="790" y="44" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="e20" value="holds" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e21" value="shown to" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="STAGE 0 &amp;#8212; ASKING IT SEVERAL WAYS  (arch7.3, section 22.3: the anchor, the rewordings, the fidelity gate, the wave; under PIPELINE_VERSION=v6_3_1 this stage is not run, and the one run reads the turns in its own supervise)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1160" height="572" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;screen&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the Supervisor on the question as typed, with the turns (v8), LLM&lt;/font&gt;&lt;br&gt;- the anchor: verdict, intent, the answer contract -- read in the light of the turns&lt;br&gt;- + standalone: the follow-up restated to stand alone; C1 numbers, C2 literals,&lt;br&gt;- C3 polarity, C4 shape in code against the words typed; held, it becomes the question&lt;br&gt;- every rewording is held to this contract, built from the standalone's words&lt;br&gt;- nothing is reworded before this call; the verdict is on the words typed&lt;br&gt;- model: standard with turns shown (v8); else light, or standard if pre-screened" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c22"><mxGeometry x="350" y="50" width="460" height="128" as="geometry"/></mxCell>
        <mxCell id="c24" value="Refuse (out of domain, injected)&lt;br&gt;or ask to clarify (ambiguous)&lt;br&gt;&amp;#8212; nothing is reworded" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="c22"><mxGeometry x="840" y="68" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e25" value="verdict &amp;#8800; proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;paraphrase&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the Paraphraser, LLM, one structured call&lt;/font&gt;&lt;br&gt;- the standalone question (v8) and what may not change, in plain words; no rows or column names&lt;br&gt;- keeps every number, year, name, quoted value, the entities, the measure,&lt;br&gt;- the period, the direction and the row count; varies words and sentence shape&lt;br&gt;- writes up to ENSEMBLE_MAX_PARAPHRASES (10), most different first, each with 'what changed'&lt;br&gt;- asked once more for replacements if too few pass the gate; never a third time" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c22"><mxGeometry x="330" y="200" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="e27" value="proceed" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c28" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F1 numbers&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- the multiset of numerals equals&lt;br&gt;- the original's; number words&lt;br&gt;- one to twenty count as numerals&lt;br&gt;- 'top ten' -&amp;gt; 'top five' fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="16" y="340" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F2 literals&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- every quoted string and every&lt;br&gt;- capitalised multi-word phrase&lt;br&gt;- appears verbatim (case-insensitive)&lt;br&gt;- 'Dairy &amp;amp; Eggs' -&amp;gt; 'dairy' fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="245" y="340" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F3 polarity&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- the direction classes present are&lt;br&gt;- equal: superlative high / low,&lt;br&gt;- change up / down, negation&lt;br&gt;- 'lowest' -&amp;gt; 'highest' fails" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="474" y="340" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F4 the same contract&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- the Supervisor reads the rewording&lt;br&gt;- (no turns: it stands alone); its contract,&lt;br&gt;- in the standalone's shape, must equal&lt;br&gt;- the anchor's: entities, measure, period" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c22"><mxGeometry x="703" y="340" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;F5 distinct&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;- differs from the original and from&lt;br&gt;- each one before it that passed;&lt;br&gt;- token Jaccard &amp;lt;= 0.8 to each&lt;br&gt;- two that differ by a comma: one kept" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="932" y="340" width="208" height="118" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="screen_paraphrase &amp;#8212; one rewording after another by default (OLLAMA_PARALLEL_CALLS=1); a rewording that fails any check is discarded with the check's name and never run" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="c22"><mxGeometry x="16" y="318" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;plan_wave&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;join, no LLM&lt;/font&gt;&lt;br&gt;- wave 1: the original + the first ENSEMBLE_PARAPHRASES (3) faithful rewordings -&amp;gt; 4 runs&lt;br&gt;- wave 2: the rest, up to 10 in all -- only when the vote is unsettled, while waves &amp;lt; ENSEMBLE_WAVES (2)&lt;br&gt;- and, when a deadline is set (ENSEMBLE_DEADLINE_SECONDS; none by default), before it; a wave in flight is always awaited" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c22"><mxGeometry x="310" y="480" width="540" height="78" as="geometry"/></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c45" value="THE CANDIDATE RUNS &amp;#8212; answer: the arch6 pipeline once per wording, one after another by default  (section 22.4; OLLAMA_PARALLEL_CALLS, 1 unless the deployer's host serves more)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="1160" height="418" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 0&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;the standalone question&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator -- shown the&lt;br&gt;- conversation's turns after the exemplars (v8)&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c45"><mxGeometry x="16" y="50" width="208" height="280" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 1&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rewording 1&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator -- shown the&lt;br&gt;- conversation's turns after the exemplars (v8)&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c45"><mxGeometry x="245" y="50" width="208" height="280" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 2&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rewording 2&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator -- shown the&lt;br&gt;- conversation's turns after the exemplars (v8)&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c45"><mxGeometry x="474" y="50" width="208" height="280" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidate 3&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;rewording 3&lt;/font&gt;&lt;br&gt;- Stage 1 on this wording:&lt;br&gt;- five retrievers, its own exemplars,&lt;br&gt;- snippets and literals; the&lt;br&gt;- Aggregator scores its rung&lt;br&gt;- Stage 2: SQL Generator -- shown the&lt;br&gt;- conversation's turns after the exemplars (v8)&lt;br&gt;- Stage 3: AST, grain* -&amp;gt; EXPLAIN -&amp;gt; run&lt;br&gt;- -&amp;gt; Completeness Reviewer;&lt;br&gt;- Repair Agent, budget 7, the ladder&lt;br&gt;- Stage 4: chart -&amp;gt; Narrator -&amp;gt; Audit&lt;br&gt;- supervise: accepts the screening&lt;br&gt;- done for it (no model call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="c45"><mxGeometry x="703" y="50" width="208" height="280" as="geometry"/></mxCell>
        <mxCell id="c50" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Candidates 4..10&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;a second wave, on disagreement&lt;/font&gt;&lt;br&gt;- up to seven more rewordings, the&lt;br&gt;- next most different first,&lt;br&gt;- each the same whole pipeline&lt;br&gt;- run only when wave 1's vote is&lt;br&gt;- unsettled (no majority, or one run),&lt;br&gt;- a wave is left and time is left&lt;br&gt;- the Judge then reads every group&lt;br&gt;- again, and the vote is recomputed&lt;br&gt;- over every candidate" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontColor=#666666;" vertex="1" parent="c45"><mxGeometry x="932" y="50" width="208" height="280" as="geometry"/></mxCell>
        <mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e55" value="wave 2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;dashed=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c50"><mxGeometry relative="1" x="0.3" as="geometry"><Array as="points"><mxPoint x="836" y="1352"/><mxPoint x="1076" y="1352"/></Array></mxGeometry></mxCell>
        <mxCell id="c56" value="Each run keeps its whole state: sql, rows, completeness, audit, attempt history and trace. Progress events and trace spans carry the candidate's index [k]; MLflow shows one trace per question with a run per wording inside it." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="c45"><mxGeometry x="16" y="348" width="1128" height="18" as="geometry"/></mxCell>
        <mxCell id="c57" value="* grain: the grain check (Phase 6, section 22.14; on by default) -- tables of different grains joined on their dates, the finer not rolled up, or on no date, the coarser still by period, go to the Repair Agent." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="c45"><mxGeometry x="16" y="370" width="1128" height="18" as="geometry"/></mxCell>
        <mxCell id="c58" value="STAGE 6 &amp;#8212; VALIDATION, THE JUDGE, THE VOTE AND FUSION  (sections 22.5-22.8: the groups in code; the Judge on every question, before the vote; the vote in code, over the accepted)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1770" width="1160" height="910" as="geometry"/></mxCell>
        <mxCell id="c59" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;validate, tier 1: admissibility&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM, per candidate&lt;/font&gt;&lt;br&gt;- E1 answered: proceed, no error (a give-up does not vote)&lt;br&gt;- E2 faithful: its wording passed the gate (the original trivially)&lt;br&gt;- E3 complete enough: the anchor contract's R1-R4 find no fatal gap -- rows at all&lt;br&gt;- E4 audited: no semantic_issue outstanding (the audit found the rows right)&lt;br&gt;- E5 comparable: not truncated, unless the question is ranked&lt;br&gt;- a gap or a dropped claim ranks a candidate lower; only the fatal cases exclude it" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c58"><mxGeometry x="70" y="50" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c60" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;validate, tier 2: agreement&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM, every pair&lt;/font&gt;&lt;br&gt;- result_matches(a, b, ordered) or (b, a): the benchmark's own scorer --&lt;br&gt;- columns as presentation, extra columns allowed, rows the same under some&lt;br&gt;- reading of the columns, numbers within 1e-6 or at two decimals&lt;br&gt;- groups = connected components (union-find), largest first, ties to the original's&lt;br&gt;- signature per group: a scalar's value, or row count + first row's labels and measure" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c58"><mxGeometry x="70" y="230" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="c61" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;judge&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;LLM, every question, before the vote&lt;/font&gt;&lt;br&gt;- the standalone question (v8), what every answer was held to, the knowledge the original's run had,&lt;br&gt;- and per group, by letter, the original's first: its SQL, columns, first five rows --&lt;br&gt;- never how many runs gave it&lt;br&gt;- -&amp;gt; a verdict per letter: accepted, or set aside with the mistake in its query named&lt;br&gt;- a letter that names no answer is ignored; an answer with no verdict stands&lt;br&gt;- cannot write SQL, call an agent or start a run (W3); once a wave&lt;br&gt;- model: heavy, always; if it fails, the runs vote alone" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c58"><mxGeometry x="70" y="400" width="500" height="160" as="geometry"/></mxCell>
        <mxCell id="c62" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;vote&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM, the accepted only&lt;/font&gt;&lt;br&gt;- A = the admissible less those set aside; g = the largest accepted group&lt;br&gt;- unanimous (g = A), majority (g &amp;gt; A/2 and g &amp;gt;= 2), single (A = 1)&lt;br&gt;- judged: the winner is not the runs' own choice -- the Judge set that aside&lt;br&gt;- accepted none: the runs' own choice, 'contested', with the Judge's objection&lt;br&gt;- none admissible: none -- the original's give-up is delivered&lt;br&gt;- the Judge off, or nothing to judge: the runs vote alone" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c58"><mxGeometry x="70" y="590" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c63" value="no majority:&lt;br&gt;a wave left,&lt;br&gt;time left?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="c58"><mxGeometry x="250" y="778" width="140" height="104" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;fuse&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- select the representative: complete &amp;gt; audited &amp;gt; the original &amp;gt;&lt;br&gt;- fewer attempts &amp;gt; cheaper plan &amp;gt; lower index; its SQL, rows, chart&lt;br&gt;- no SQL is ever fused (the generator is the only place SQL is written)&lt;br&gt;- columns other members carried, joined on the entity's key when every&lt;br&gt;- row matches once (ENSEMBLE_FUSE_COLUMNS: a toggle, on by default)&lt;br&gt;- claims: the others' about rows not yet spoken of, checked cell by cell,&lt;br&gt;- re-audited; at most ENSEMBLE_MAX_CLAIMS (8); assumptions once&lt;br&gt;- dissent: each loser's key fact + its tables, filters, roll-ups and joins" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c58"><mxGeometry x="650" y="400" width="450" height="204" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;deliver&lt;/u&gt;&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;no LLM&lt;/font&gt;&lt;br&gt;- render_answer for the standalone question: the fused claims, the table,&lt;br&gt;- 'Read as: ...' first when a follow-up was restated (v8), then the agreement line&lt;br&gt;- ('agreed by 4 of 4 runs'; what the Judge set aside),&lt;br&gt;- the dissent among the notes; folded beneath: every candidate's wording, what&lt;br&gt;- it changed, outcome, SQL, key fact, the Judge's verdict on it; the discarded&lt;br&gt;- rewordings with the check that discarded them" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c58"><mxGeometry x="650" y="772" width="450" height="130" as="geometry"/></mxCell>
        <mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e68" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e69" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontColor=#333333;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e71" value="the admissible" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c59" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e72" value="the groups" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c60" target="c61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e73" value="Judge off" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c60" target="c62"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="65" y="2084"/><mxPoint x="65" y="2405"/></Array></mxGeometry></mxCell>
        <mxCell id="e74" value="a verdict per group" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
