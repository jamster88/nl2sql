        <mxCell id="e84" value="answer" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c65" target="c81"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="2702"/><mxPoint x="620" y="2702"/></Array></mxGeometry></mxCell>
        <mxCell id="c85" value="STAGE 5 &amp;#8212; HUMAN REVIEW (v5.1-5.6; v8: the snapshot names the pipeline and the turn)  (the verdict is on the delivered answer)" style="swimlane;html=1;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;strokeColor=#666666;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="2816" width="1160" height="136" as="geometry"/></mxCell>
        <mxCell id="c86" value="- the three verdicts, the staging database, the review and curation pages: as arch6 section 14&lt;br&gt;- the snapshot gains the ensemble record, so a reviewer fixing a wrong answer sees the dissent and the other queries that agreed&lt;br&gt;- promotion into the golden set uses the standalone question and the chosen SQL: a golden pair must stand alone; the words typed are kept beside it&lt;br&gt;- the snapshot gains pipeline and conversation (written when the store has the columns); a verdict of 'no' also forgets the turn (v8)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=5;spacingTop=0;spacingRight=5;spacingBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c85"><mxGeometry x="20" y="44" width="1120" height="76" as="geometry"/></mxCell>
