        <mxCell id="e78" value="yes: a second wave, then validate, judge and vote again (one counter: waves)" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c63" target="c39"><mxGeometry relative="1" x="-0.45" as="geometry"><Array as="points"><mxPoint x="20" y="2600"/><mxPoint x="20" y="1219"/></Array></mxGeometry></mxCell>
