# MLflow's front door: every request asked about at the auth service.
#
# A browser that has not signed in is sent to; an MLflow client -- the
# benchmark, a notebook -- signs in with MLFLOW_TRACKING_USERNAME and
# _PASSWORD, which MLflow sends as Basic credentials. Who may pass is
# MLFLOW_ALLOWED_ROLES, on the auth service.
server {
    listen ${PROXY_PORT}${PROXY_LISTEN_TLS};
    server_name _;
    include /tmp/nginx/server-tls.conf;

    # Artifacts -- a benchmark's report, a trace's attachments -- are
    # uploaded through here.
    client_max_body_size 512m;

    include /etc/nginx/nl2sql/shared/health.conf;
    include /tmp/nginx/auth.conf;

    # The question asked about every request: may this through? The method
    # goes along, because a write riding on a cookie has to come from this
    # page's own origin.
    location = /_nl2sql_verify {
        internal;
        resolver ${PROXY_RESOLVER} valid=10s ipv6=off;
        set $auth_upstream ${AUTH_UPSTREAM};
        proxy_pass $auth_upstream/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URI $request_uri;
        include /tmp/nginx/auth-tls.conf;
    }

    # A browser is sent to sign in and brought back; a client of MLflow's API
    # is told 401, which its library reports, rather than handed a page.
    location @signin {
        if ($uri ~ ^/(api|ajax-api)/) {
            return 401;
        }
        return 302 /auth/login?next=$request_uri;
    }

    location @forbidden {
        default_type text/plain;
        return 403 "Refused: signed in as someone not in a group that may use MLflow (MLFLOW_ALLOWED_ROLES on the auth service), or a change sent from another site. To sign in as someone else: /auth/login\n";
    }

    # MLflow's own health route, open: it answers "OK" and nothing else.
    location = /health {
        resolver ${PROXY_RESOLVER} valid=10s ipv6=off;
        set $upstream ${UPSTREAM};
        proxy_pass $upstream$request_uri;
        include /tmp/nginx/upstream-tls.conf;
    }

    location / {
        # The auth_request when sign-in is on; nothing when it is off.
        include /tmp/nginx/mlflow-signin.conf;
        resolver ${PROXY_RESOLVER} valid=10s ipv6=off;
        set $upstream ${UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        # Host is left as nginx's default -- the upstream's own name -- which
        # is one MLflow's --allowed-hosts already answers.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nl2sql_forwarded_proto;
        # Always dropped: the session, or the client's credentials, were for
        # this proxy, and MLflow's server takes none.
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        include /tmp/nginx/upstream-tls.conf;
        proxy_read_timeout ${UPSTREAM_READ_TIMEOUT};
    }
}
