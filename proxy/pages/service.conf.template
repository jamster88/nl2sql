# The review, curation and console pages: each its bundle, and its service.
#
# The review and curation pages front the review service, whose token can
# rewrite the golden question set and the snippets; the console's fronts the
# SQL console. Keeping any token on this side of the hop is why a browser
# never has to hold it. No event stream behind these, so no buffering
# changes; a long read timeout instead, because a promotion runs the loaders
# and re-embeds, which the review service caps at its own
# REVIEW_RELOAD_TIMEOUT_SECONDS and this has to outlast.
server {
    listen ${PROXY_PORT}${PROXY_LISTEN_TLS};
    server_name _;
    include /tmp/nginx/server-tls.conf;
    root ${PAGE_ROOT};

    include /etc/nginx/nl2sql/shared/site.conf;
    include /etc/nginx/nl2sql/shared/health.conf;
    include /tmp/nginx/auth.conf;

    location ~ ^/(v1|healthz|readyz|openapi\.json) {
        resolver ${PROXY_RESOLVER} valid=10s ipv6=off;
        set $upstream ${UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nl2sql_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Authorization "${UPSTREAM_AUTH_HEADER}";
        proxy_set_header Connection "";
        include /tmp/nginx/upstream-tls.conf;
        proxy_read_timeout ${UPSTREAM_READ_TIMEOUT};
        proxy_send_timeout ${UPSTREAM_READ_TIMEOUT};
    }
}
