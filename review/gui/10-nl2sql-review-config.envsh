#!/bin/sh
# The four decisions nginx cannot make for itself, made before its templates
# are substituted.
#
# Sourced rather than executed -- hence `.envsh`, which the nginx image's
# entrypoint treats differently -- because the first of the two exports a
# variable the envsubst step after it has to see.

set -eu

# 1. The Authorization header.
#
#    The point of the indirection is the empty case: nginx drops a header
#    whose value is the empty string, so a deployment with no token sends no
#    Authorization header at all rather than "Bearer " with nothing after it.
#
#    This token can rewrite the golden question set, which is why it is set
#    here and never reaches the browser.
#    With sign-in on (AUTH_ENABLED=true) the proxy adds none: the browser's
#    own session cookie goes through, and the person it names is who did it.
#    A token here would let every visitor act as the service.
case "${AUTH_ENABLED:-false}" in
    true|1|yes|on) export REVIEW_AUTH_HEADER="" ;;
    *)
        if [ -n "${REVIEW_TOKEN:-}" ]; then
            export REVIEW_AUTH_HEADER="Bearer ${REVIEW_TOKEN}"
        else
            export REVIEW_AUTH_HEADER=""
        fi
        ;;
esac

# 2. Whether there is a certificate to verify.
#
#    `proxy_ssl_trusted_certificate` is read while nginx parses its config,
#    so naming a file that is not there stops the container from starting,
#    with a BIO error that says nothing about why. That is the right outcome
#    for an HTTPS upstream; the message is just worth replacing with one
#    that says what to do.
#
#    It is the wrong outcome behind REVIEW_TLS_ENABLED=false, where the
#    service serves plain HTTP and there is no certificate anywhere.
#
#    The destination is overridable only so this script can be run against a
#    temporary directory by the test suite. Nothing sets it in the image.
tls_conf="${NGINX_REVIEW_UPSTREAM_TLS_CONF:-/etc/nginx/nl2sql-review-upstream-tls.conf}"

case "${REVIEW_UPSTREAM}" in
    https://*)
        if [ ! -r "${REVIEW_CACERT}" ]; then
            echo "nl2sql-review-gui: REVIEW_UPSTREAM is ${REVIEW_UPSTREAM} but there is no" >&2
            echo "  readable certificate at REVIEW_CACERT=${REVIEW_CACERT} to verify it." >&2
            echo "  The review service presents the certificate the agent API generates," >&2
            echo "  so this usually means the API has not started yet, or the apitls" >&2
            echo "  volume is not mounted here." >&2
            exit 1
        fi
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-review-config.envsh because REVIEW_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${REVIEW_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${REVIEW_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$tls_conf" <<TLSEOF
# Written by 10-nl2sql-review-config.envsh. REVIEW_UPSTREAM is
# ${REVIEW_UPSTREAM} -- plain HTTP, so there is no certificate to verify.
# Everything the reviewer's browser sends, including their edits to the
# golden question set, crosses in clear text.
TLSEOF
        ;;
esac

# 3. The sign-in hop: `/auth/` goes to the auth service, which presents the
#    same certificate as the API. Checked as the upstream above is, for the
#    same reason; the destination is overridable for the tests alone.
auth_conf="${NGINX_AUTH_TLS_CONF:-/etc/nginx/nl2sql-auth-tls.conf}"
case "${AUTH_UPSTREAM}" in
    https://*)
        if [ ! -r "${AUTH_CACERT}" ]; then
            echo "nl2sql-review-gui: AUTH_UPSTREAM is ${AUTH_UPSTREAM} but there is no" >&2
            echo "  readable certificate at AUTH_CACERT=${AUTH_CACERT} to verify it." >&2
            echo "  The auth service presents the certificate the agent API generates," >&2
            echo "  so this usually means the API has not started yet, or the apitls" >&2
            echo "  volume is not mounted here." >&2
            exit 1
        fi
        cat > "$auth_conf" <<TLSEOF
# Written by 10-nl2sql-review-config.envsh because AUTH_UPSTREAM is HTTPS.
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate ${AUTH_CACERT};
proxy_ssl_server_name on;
proxy_ssl_name ${AUTH_SSL_NAME};
TLSEOF
        ;;
    *)
        cat > "$auth_conf" <<TLSEOF
# Written by 10-nl2sql-review-config.envsh. AUTH_UPSTREAM is ${AUTH_UPSTREAM} -- plain
# HTTP, so passwords cross this hop in clear text; that is only right behind
# something that terminates TLS itself.
TLSEOF
        ;;
esac

# 4. This page's own listener. HTTPS by default, because a password is typed
#    into it; the certificate is the API's, which covers localhost. Off
#    (REVIEW_GUI_TLS_ENABLED=false) only behind something that terminates TLS.
server_conf="${NGINX_SERVER_TLS_CONF:-/etc/nginx/nl2sql-server-tls.conf}"
case "${REVIEW_GUI_TLS_ENABLED:-true}" in
    false|0|no|off)
        export REVIEW_GUI_LISTEN_TLS=""
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-review-config.envsh. REVIEW_GUI_TLS_ENABLED=false: this page is
# plain HTTP, and so is every password typed into it.
TLSEOF
        ;;
    *)
        if [ ! -r "${REVIEW_GUI_TLS_CERT_FILE}" ] || [ ! -r "${REVIEW_GUI_TLS_KEY_FILE}" ]; then
            echo "nl2sql-review-gui: REVIEW_GUI_TLS_ENABLED is on but ${REVIEW_GUI_TLS_CERT_FILE} or" >&2
            echo "  ${REVIEW_GUI_TLS_KEY_FILE} is not readable. They come from the apitls volume" >&2
            echo "  the API writes on its first start; mount it, or set REVIEW_GUI_TLS_ENABLED=false" >&2
            echo "  behind something that terminates TLS itself." >&2
            exit 1
        fi
        export REVIEW_GUI_LISTEN_TLS=" ssl"
        cat > "$server_conf" <<TLSEOF
# Written by 10-nl2sql-review-config.envsh because REVIEW_GUI_TLS_ENABLED is on.
ssl_certificate ${REVIEW_GUI_TLS_CERT_FILE};
ssl_certificate_key ${REVIEW_GUI_TLS_KEY_FILE};
ssl_protocols TLSv1.2 TLSv1.3;
TLSEOF
        ;;
esac
